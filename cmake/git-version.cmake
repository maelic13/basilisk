# Writes the generated header that names a development build's commit, as
# Stockfish does: the commit's date, its first 8 hash characters, and whether
# the working tree differs from it. Run at every build (`basilisk_git_version`)
# so a commit made without reconfiguring never leaves a stale name; the header
# is rewritten only when its content changes.
#
# Inputs: SRC_DIR (the source tree), OUT (the header), GIT (the git found at
# configure time; a build without one reads "nogit"), DEV_ID (optional; when
# set, the build reports exactly this instead of reading git, which fixes the
# string for byte-identity comparisons).

if(NOT DEFINED SRC_DIR OR NOT DEFINED OUT)
    message(FATAL_ERROR "git-version.cmake needs SRC_DIR and OUT")
endif()

set(_lines "// Generated by cmake/git-version.cmake at build time; do not edit.\n#pragma once\n")

if(DEV_ID)
    string(APPEND _lines "#define BASILISK_DEV_ID \"${DEV_ID}\"\n")
else()
    set(GIT_EXECUTABLE "${GIT}")
    if(GIT AND EXISTS "${GIT}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
            WORKING_DIRECTORY "${SRC_DIR}" OUTPUT_VARIABLE _sha RESULT_VARIABLE _sha_rc
            OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        execute_process(COMMAND "${GIT_EXECUTABLE}" show -s --date=format:%Y%m%d --format=%cd HEAD
            WORKING_DIRECTORY "${SRC_DIR}" OUTPUT_VARIABLE _date RESULT_VARIABLE _date_rc
            OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(_sha_rc EQUAL 0 AND _sha MATCHES "^[0-9a-f]+$")
            string(SUBSTRING "${_sha}" 0 8 _sha8)
            string(APPEND _lines "#define BASILISK_GIT_SHA \"${_sha8}\"\n")
        endif()
        if(_date_rc EQUAL 0 AND _date MATCHES "^[0-9]+$")
            string(APPEND _lines "#define BASILISK_GIT_DATE \"${_date}\"\n")
        endif()
        # The clone's own line-ending settings, not Stockfish's
        # core.autocrlf=false: a CRLF working copy over an LF index would
        # otherwise read as modified on every Windows build.
        execute_process(COMMAND "${GIT_EXECUTABLE}" update-index --refresh
            WORKING_DIRECTORY "${SRC_DIR}" OUTPUT_QUIET ERROR_QUIET)
        execute_process(COMMAND "${GIT_EXECUTABLE}" diff-index --quiet HEAD --
            WORKING_DIRECTORY "${SRC_DIR}" RESULT_VARIABLE _diff_rc OUTPUT_QUIET ERROR_QUIET)
        if(_diff_rc EQUAL 1)
            string(APPEND _lines "#define BASILISK_GIT_MODIFIED 1\n")
        endif()
    endif()
endif()

file(WRITE "${OUT}.tmp" "${_lines}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
