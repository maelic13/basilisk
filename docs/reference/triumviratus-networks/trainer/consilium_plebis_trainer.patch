+"""Unit test of RouterEM.assign (Consilium-2, 21/10/2026) on synthetic data, CPU only: runs, respects the budget,
+the minimum share and the move limit, and how long it takes. Usage: python c2_test_assign.py"""
+import time
+
+import numpy as np
+
+from model.modules.features.halfka_v2_hm_x import NUM_CELLS, NUM_EXPERTS, default_router_table
+from trainer.router_em import assign
+
+rng = np.random.default_rng(0)
+z = np.load("c2_transitions.npz")
+trans = (z["src"].astype(np.int64), z["dst"].astype(np.int64), z["w"].astype(np.float64))
+cur = default_router_table().numpy().astype(np.int64)
+N = np.zeros(NUM_CELLS)
+used = np.unique(np.concatenate([trans[0], trans[1]]))
+N[used] = rng.integers(0, 60000, size=len(used))
+D = rng.normal(0, 1, size=(NUM_CELLS, NUM_EXPERTS)) * N[:, None] * 1e-3
+D[np.arange(NUM_CELLS), cur] = 0.0
+src, dst, wt = trans
+cross = lambda t: 2.0 * float((wt * (t[src] != t[dst])).sum() / wt.sum())
+for budget in (0.25, 0.15):
+    t0 = time.time()
+    new, mu = assign(D, N, cur, trans, budget, 0.04, 0.15, 2000)
+    share = np.bincount(new, weights=N, minlength=NUM_EXPERTS) / N.sum()
+    moved = N[new != cur].sum() / N.sum()
+    print(f"budget {budget}: {time.time() - t0:.1f} s, crossing {cross(cur):.4f} -> {cross(new):.4f}, mu {mu:.3g}, "
+          f"moved share {moved:.3f}, min share {share.min():.3f}, gain {sum(D[c, new[c]] for c in range(NUM_CELLS)):.1f}")
