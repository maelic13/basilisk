+// Mobility inputs — blocco PROPRIO di Triumviratus (8.0, graft sulla MoE-1024), 29/09/2026.
+// FullThreats vede solo attacchi su PEZZI; qui entrano gli attacchi su case vuote, in forma
+// bucketizzata: una feature per cavallo/alfiere/torre/donna (proprio o avversario) =
+// (casa orientata, bucket di mobilita' 0-3).
+//   indice   = (own ? 0 : 4 + (pt - Knight)) * 256 + (sq ^ orient) * 4 + bucket
+//   orient   = FullThreats::OrientTBL[persp][ksq]  (come PassedPawns)
+//   mobilita = popcount(attacks(pt, sq, tutti i pezzi) & ~(pezzi propri | attacchi dei pedoni nemici))
+//   bucket   = numero di soglie superate, per tipo: N {2,4,6}, B {3,6,9}, R {4,7,10}, Q {7,13,19}
+// Ordine di raccolta e tetto a 32 come il motore (Mobility::collect: bianco poi nero, N..Q,
+// case crescenti).
+// 🔴 DEVE combaciare con Triumviratus_8.0/nnue/nnue/features/mobility.{h,cpp}. Il gate che lo
+// verifica e' cross_check_eval.py con una rete random a pesi Mobility non nulli.
+// ---------------------------------------------------------------------------
+struct Mobility {
+    static constexpr std::string_view NAME = "Mobility";
+
+    static constexpr int INPUTS              = 2048;
+    static constexpr int MAX_ACTIVE_FEATURES = 32;
+
+    static constexpr int THRESHOLDS[4][3] = {{2, 4, 6}, {3, 6, 9}, {4, 7, 10}, {7, 13, 19}};
+
+    static int bucket(int t, int mob) {
+        return (mob >= THRESHOLDS[t][0]) + (mob >= THRESHOLDS[t][1]) + (mob >= THRESHOLDS[t][2]);
+    }
+
+    static std::pair<int, int>
+    fill_features_sparse(const TrainingDataEntry& e, int* features, Color color) {
+        auto&     pos    = e.pos;
+        const int orient = int(FullThreats::OrientTBL[(int) color][(int) pos.kingSquare(color)]);
+        int       k      = 0;
+        for (Color c : {Color::White, Color::Black})
+        {
+            const Color    them   = c == Color::White ? Color::Black : Color::White;
+            const Bitboard eAtt   = bb::pawnAttacks(pos.piecesBB(Piece(PieceType::Pawn, them)), them);
+            const Bitboard area   = ~(pos.piecesBB(c) | eAtt);
+            const int      side   = c == color ? 0 : 4;
+            for (int t = 0; t < 4; ++t)
+            {
+                const PieceType pt = PieceType((int) PieceType::Knight + t);
+                for (Square sq : pos.piecesBB(Piece(pt, c)))
+                {
+                    if (k >= MAX_ACTIVE_FEATURES)
+                        return {k, INPUTS};
+                    const int mob = (pos.attacks(sq) & area).count();
+                    features[k++] = (side + t) * 256 + ((int(sq) ^ orient) << 2) + bucket(t, mob);
+                }
+            }
+        }
+        return {k, INPUTS};
+    }
+};
