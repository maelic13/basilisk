diff -ruN -x .pgo a/c2_gate_int.py b/c2_gate_int.py
--- a/c2_gate_int.py	1970-01-01 01:00:00.000000000 +0100
+++ b/c2_gate_int.py	2026-10-21 13:17:11.690736100 +0200
@@ -0,0 +1,295 @@
+"""Gate 1 of Consilium-2 (21/10/2026): integer evaluation of the exported .nnue against the trainer.
+
+1. Builds a random Consilium-2 network (experts made different, pawn-king subnetwork active, a random routing table),
+   clips it, exports it with the serializer (int8 HalfKA, router and pawn-king sections) and reads it back.
+2. Evaluates sampled game positions in two independent ways:
+   - the trainer's model read from the file (float, fake quantization as in training) x nnue2score;
+   - an integer evaluator written here from the file bytes, with the rules of tools/halfka_int8/simulate.py (verified
+     against the engine on 51/51 positions on 12/10/2026): accumulators, clamp 0..255, pairwise product / 512, fc_0
+     + pawn-king output, SqrClippedReLU >> 21, ClippedReLU >> 7, fc_1, >> 19, >> 6, fc_2, skip fc_0[30]-fc_0[31],
+     x 9600 / 16384, psqt / 2, both / 16, C++ truncations.
+   The expected differences are rounding only (historical cross-checks: mean |d| 0.6-1.7 internal units).
+3. Checks the export round trip (router table, pawn-king tensors) and the int8 range of the HalfKA block.
+This is also the reference the engine must match after the launch.
+Usage: python c2_gate_int.py game.pgn [positions] [--out net.nnue]
+"""
+import argparse
+import io
+import random
+import struct
+
+import chess.pgn
+import numpy as np
+import torch
+
+import model as M
+from data_loader._native import set_router_table
+from data_loader.stream import destroy_sparse_batch, get_sparse_batch_from_fens
+from model.modules.features.halfka_v2_hm_x import NUM_CELLS, NUM_EXPERTS
+from model.modules.pawn_king import PK_HASH, PK_INPUTS
+from model.utils.serialize import ROUTER_MAGIC, NNUEReader, NNUEWriter
+
+FEATURES = "Full_Threats+HalfKAv2_hm_X8^+PP_3Wide+PassedPawns"
+LOADER_FEATURES = "Full_Threats+HalfKAv2_hm_X8+PP_3Wide+PassedPawns"
+L1, HALF, L2, L3, PSQT_B, LS = 1024, 512, 32, 32, 8, 8
+THREAT, HKA_TRAIN, HKA_EXPORT, PP, PA = 59808, 24576 * 8, 22528 * 8, 4560, 96
+PK_H = 256
+MAGIC = b"COMPRESSED_LEB128"
+
+
+# ---------------------------------------------------------------- file reader (independent of the serializer)
+def decode_leb128(buf, count):
+    out = np.zeros(count, dtype=np.int64)
+    i = k = 0
+    while k < count:
+        v = shift = 0
+        while True:
+            b = int(buf[i]); i += 1
+            v |= (b & 0x7F) << shift
+            shift += 7
+            if not b & 0x80:
+                if b & 0x40:
+                    v -= 1 << shift
+                break
+        out[k] = v
+        k += 1
+    return out
+
+
+class R:
+    def __init__(self, data):
+        self.f = io.BytesIO(data)
+
+    def u32(self):
+        return struct.unpack("<I", self.f.read(4))[0]
+
+    def tensor(self, dtype, count):
+        pos = self.f.tell()
+        if self.f.read(len(MAGIC)) == MAGIC:
+            n = self.u32()
+            return decode_leb128(np.frombuffer(self.f.read(n), dtype=np.uint8), count).astype(dtype)
+        self.f.seek(pos)
+        return np.frombuffer(self.f.read(np.dtype(dtype).itemsize * count), dtype=dtype).copy()
+
+
+def read_net(data):
+    r = R(data)
+    net = {}
+    r.u32(); r.u32()
+    r.f.read(r.u32())
+    r.u32()                                   # FT hash
+    net["bias"] = r.tensor(np.int16, L1).astype(np.int32)
+    segs = [("thr", THREAT, np.int8), ("hka", HKA_EXPORT, np.int8), ("pp", PP, np.int8), ("pa", PA, np.int8)]
+    for name, n, dt in segs:
+        net[name + "_w"] = r.tensor(dt, n * L1).reshape(n, L1).astype(np.int32)
+        net[name + "_psqt"] = r.tensor(np.int32, n * PSQT_B).reshape(n, PSQT_B).astype(np.int64)
+    net["ls"] = []
+    for _ in range(LS):
+        r.u32()
+        d = {}
+        d["b0"] = r.tensor(np.int32, L2); d["w0"] = r.tensor(np.int8, L2 * L1).reshape(L2, L1)
+        d["b1"] = r.tensor(np.int32, L3); d["w1"] = r.tensor(np.int8, L3 * 64).reshape(L3, 64)
+        d["b2"] = r.tensor(np.int32, 1); d["w2"] = r.tensor(np.int8, 128).reshape(1, 128)
+        net["ls"].append(d)
+    assert r.u32() == ROUTER_MAGIC
+    n = r.u32(); k = r.u32()
+    assert n == NUM_CELLS and k == NUM_EXPERTS
+    net["router"] = np.frombuffer(r.f.read(n), dtype=np.uint8).copy()
+    assert r.u32() == PK_HASH
+    h = r.u32(); o = r.u32()
+    net["pk_b1"] = np.frombuffer(r.f.read(2 * h), "<i2").astype(np.int64)
+    net["pk_w1"] = np.frombuffer(r.f.read(2 * PK_INPUTS * h), "<i2").reshape(PK_INPUTS, h).astype(np.int64)
+    net["pk_b2"] = np.frombuffer(r.f.read(4 * o), "<i4").astype(np.int64)
+    net["pk_w2"] = np.frombuffer(r.f.read(o * h), "<i1").reshape(o, h).astype(np.int64)
+    assert r.f.read() == b"", "bytes left after the last section"
+    return net
+
+
+# ---------------------------------------------------------------- integer forward
+def tdiv(a, b):
+    q = np.abs(a) // b
+    return np.where(a < 0, -q, q)
+
+
+def accumulate(net, idx):
+    """Accumulator (int16 range) and PSQT of one perspective from the loader's training indices."""
+    n, m = idx.shape
+    acc = np.repeat(net["bias"][None, :], n, axis=0).astype(np.int64)
+    ps = np.zeros((n, PSQT_B), dtype=np.int64)
+    for j in range(m):
+        col = idx[:, j]
+        for name, lo, hi, conv in (
+            ("thr", 0, THREAT, lambda t: t),
+            ("hka", THREAT, THREAT + HKA_TRAIN, None),
+            ("pp", THREAT + HKA_TRAIN, THREAT + HKA_TRAIN + PP, lambda t: t - THREAT - HKA_TRAIN),
+            ("pa", THREAT + HKA_TRAIN + PP, THREAT + HKA_TRAIN + PP + PA, lambda t: t - THREAT - HKA_TRAIN - PP),
+        ):
+            sel = (col >= lo) & (col < hi)
+            if not sel.any():
+                continue
+            t = col[sel]
+            if conv is None:
+                r0 = t - THREAT
+                e, r1 = r0 // 24576, r0 % 24576
+                bucket, plane, sq = r1 // 768, (r1 % 768) // 64, r1 % 64
+                rows = (e * 32 + bucket) * 704 + np.minimum(plane, 10) * 64 + sq
+            else:
+                rows = conv(t)
+            acc[sel] += net[name + "_w"][rows]
+            ps[sel] += net[name + "_psqt"][rows]
+    assert acc.min() >= -32768 and acc.max() <= 32767, "accumulator outside int16"
+    return acc, ps
+
+
+def pawn_king_int(net, pk_idx):
+    h = np.repeat(net["pk_b1"][None, :], pk_idx.shape[0], axis=0)
+    for j in range(pk_idx.shape[1]):
+        col = pk_idx[:, j]
+        sel = col >= 0
+        h[sel] += net["pk_w1"][col[sel]]
+    assert h.min() >= -32768 and h.max() <= 32767, "pawn-king accumulator outside int16"
+    h = np.clip(h, 0, 127)
+    return net["pk_b2"][None, :] + h @ net["pk_w2"].T
+
+
+def int_eval(net, stm_white, w, b, pc, pk_idx, parts=None):
+    acc_w, ps_w = accumulate(net, w)
+    acc_b, ps_b = accumulate(net, b)
+    acc_us = np.where(stm_white[:, None], acc_w, acc_b)
+    acc_th = np.where(stm_white[:, None], acc_b, acc_w)
+    x = np.empty((len(pc), L1), dtype=np.int64)
+    for p, acc in enumerate((acc_us, acc_th)):
+        a = np.clip(acc[:, :HALF], 0, 255)
+        c = np.clip(acc[:, HALF:], 0, 255)
+        x[:, p * HALF:(p + 1) * HALF] = (a * c) // 512
+    bucket = (pc - 1) // 4
+    pk = pawn_king_int(net, pk_idx)
+    pos = np.empty(len(pc), dtype=np.int64)
+    for bk in np.unique(bucket):
+        sel = bucket == bk
+        d = net["ls"][bk]
+        fc0 = d["b0"].astype(np.int64) + x[sel] @ d["w0"].astype(np.int64).T + pk[sel]
+        sq0 = np.minimum(127, (fc0 * fc0) >> 21)
+        cr0 = np.clip(fc0 >> 7, 0, 127)
+        c01 = np.concatenate([sq0, cr0], axis=1)
+        fc1 = d["b1"].astype(np.int64) + c01 @ d["w1"].astype(np.int64).T
+        sq1 = np.minimum(127, (fc1 * fc1) >> 19)
+        cr1 = np.clip(fc1 >> 6, 0, 127)
+        cc = np.concatenate([c01, sq1, cr1], axis=1)
+        fc2 = d["b2"].astype(np.int64) + cc @ d["w2"].astype(np.int64).T
+        fwd = fc2[:, 0] + (fc0[:, 30] - fc0[:, 31])
+        pos[sel] = tdiv(fwd * 9600, 16384)
+    n = np.arange(len(pc))
+    ps_us = np.where(stm_white, ps_w[n, bucket], ps_b[n, bucket])
+    ps_th = np.where(stm_white, ps_b[n, bucket], ps_w[n, bucket])
+    psqt = tdiv(ps_us - ps_th, 2)
+    if parts is not None:
+        parts.extend(zip(psqt.tolist(), pos.tolist()))
+    return tdiv(psqt, 16) + tdiv(pos, 16)
+
+
+# ---------------------------------------------------------------- random network
+def random_model(seed):
+    torch.manual_seed(seed)
+    cfg = M.ModelConfig()
+    cfg.pawn_king_hidden = PK_H
+    model = M.NNUEModel(FEATURES, cfg)
+    with torch.no_grad():
+        for f in model.input.features:
+            L = f.num_outputs - 8
+            if hasattr(f, "router"):
+                f.base_weight[:, :L].uniform_(-0.06, 0.06)
+                f.weight[:, :L].uniform_(-0.05, 0.05)            # the experts differ
+                f.virtual_weight[:, :L].uniform_(-0.01, 0.01)
+                f.router.copy_(torch.randint(0, NUM_EXPERTS, (NUM_CELLS,), dtype=torch.uint8))
+            else:
+                f.weight[:, :L].uniform_(-0.06, 0.06)
+        model.input.bias[:L1].uniform_(0.1, 0.5)
+        pk = model.pawn_king
+        pk.w1.weight.uniform_(-0.3, 0.3)
+        pk.w1.weight[PK_INPUTS].zero_()
+        pk.b1.uniform_(-0.2, 0.6)
+        pk.out.weight.uniform_(-0.5, 0.5)
+        pk.out.bias.uniform_(-0.5, 0.5)
+    model.clip_weights(include_input=True)
+    return model, cfg
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("pgn")
+    ap.add_argument("positions", nargs="?", type=int, default=3000)
+    ap.add_argument("--out", default="")
+    ap.add_argument("--seed", type=int, default=7)
+    ap.add_argument("--net", default="", help="check an exported network instead of a random one")
+    ap.add_argument("--dump", default="", help="write <dump>.fen and <dump>.int (psqt positional total per position) "
+                                               "for the engine's evalbatch")
+    a = ap.parse_args()
+    random.seed(a.seed)
+    fens = []
+    with open(a.pgn, encoding="utf-8", errors="replace") as f:
+        while len(fens) < a.positions:
+            g = chess.pgn.read_game(f)
+            if g is None:
+                break
+            bd = g.board()
+            for mv in g.mainline_moves():
+                bd.push(mv)
+                if random.random() < 0.08 and not bd.is_game_over():
+                    fens.append(bd.fen())
+    if a.net:
+        cfg = M.ModelConfig()
+        cfg.pawn_king_hidden = PK_H
+        out = a.net
+        with open(out, "rb") as fi:
+            model = NNUEReader(fi, FEATURES, cfg).model
+        data = open(out, "rb").read()
+    else:
+        model, cfg = random_model(a.seed)
+        data = bytes(NNUEWriter(model, verbose=False).buf)
+        out = a.out or "c2_gate_random.nnue"
+        with open(out, "wb") as fo:
+            fo.write(data)
+    with open(out, "rb") as fi:   # the trainer's reader needs a real file (np.fromfile)
+        back = NNUEReader(fi, FEATURES, cfg).model
+    net = read_net(data)
+
+    # round trip of the new sections and int8 range
+    f0 = [f for f in model.input.features if hasattr(f, "router")][0]
+    f1 = [f for f in back.input.features if hasattr(f, "router")][0]
+    ok_router = bool((f0.router == f1.router).all()) and bool((torch.from_numpy(net["router"]) == f0.router).all())
+    q0, q1 = model.pawn_king.quantized(), back.pawn_king.quantized()
+    ok_pk = all(bool((q0[k] == q1[k]).all()) for k in q0)
+    ok_i8 = int(np.abs(net["hka_w"]).max()) <= 127
+
+    n = len(fens)
+    # the loader routes with the network's table, as train.py does (without it: the default table, which the trainer
+    # and this evaluator would share, but not the engine; found on 21/10 with the engine gate)
+    set_router_table(net["router"])
+    bt = get_sparse_batch_from_fens(LOADER_FEATURES, fens, [0] * n, [40] * n, [0] * n)
+    t = tuple(x.clone() for x in bt.contents.get_tensors("cpu"))
+    destroy_sparse_batch(bt)
+    us, them, w, b, outcome, score, pc, aux = t
+    with torch.no_grad():
+        y = back(us, them, w, b, pc, True, True, aux).view(-1).double() * back.quantization.nnue2score
+    parts = []
+    ie = int_eval(net, us.view(-1).numpy() > 0.5, w.numpy().astype(np.int64), b.numpy().astype(np.int64),
+                  pc.numpy().astype(np.int64), aux[:, 2:].numpy().astype(np.int64), parts)
+    if a.dump:
+        with open(a.dump + ".fen", "w") as ff, open(a.dump + ".int", "w") as fi:
+            for fen, (ps_, po_), t_ in zip(fens, parts, ie.tolist()):
+                ff.write(fen + "\n")
+                fi.write(f"{ps_} {po_} {t_}\n")
+    yt = y.numpy()
+    d = ie - yt
+    r2 = 1 - (d ** 2).sum() / ((yt - yt.mean()) ** 2).sum()
+    pk_share = float(np.abs(pawn_king_int(net, aux[:, 2:].numpy().astype(np.int64))).mean())
+    print(f"positions {n}; |eval| mean {np.abs(yt).mean():.1f}; integer vs trainer: mean |d| {np.abs(d).mean():.3f}, "
+          f"max |d| {np.abs(d).max():.1f}, R2 {r2:.7f}; pawn-king |out| mean {pk_share:.0f} (l1 units)")
+    print(f"router round trip {ok_router}, pawn-king round trip {ok_pk}, HalfKA inside int8 {ok_i8}")
+    ok = ok_router and ok_pk and ok_i8 and r2 > 0.99999 and np.abs(d).mean() < 2.0
+    print("GATE 1", "OK" if ok else "FAILED")
+
+
+if __name__ == "__main__":
+    main()
diff -ruN -x .pgo a/c2_gate_loader.py b/c2_gate_loader.py
--- a/c2_gate_loader.py	1970-01-01 01:00:00.000000000 +0100
+++ b/c2_gate_loader.py	2026-10-21 13:17:11.705350100 +0200
@@ -0,0 +1,115 @@
+"""Gate 2 of Consilium-2 (21/10/2026): the data loader's indices against an independent python-chess computation.
+
+Checks, for positions sampled from games plus a few made by hand (promoted pieces, bare kings, Black to move):
+  - aux block: routing cell of White and of Black, the 18 pawn-king indices (order: own pawns, enemy pawns, own king,
+    enemy king, padding -1), against python-chess;
+  - HalfKAv2_hm_X8: every index equals the plain HalfKAv2_hm index + expert * 24,576 with expert = default table[cell]
+    of that perspective; the blocks after it are shifted by the larger HalfKA block; the threat block is unchanged.
+Usage: python c2_gate_loader.py game.pgn [positions]
+"""
+import random
+import sys
+
+import chess
+import chess.pgn
+import numpy as np
+
+from data_loader.stream import destroy_sparse_batch, get_sparse_batch_from_fens
+from model.modules.features.halfka_v2_hm_x import default_router_table
+
+THREATS, HKA, X8 = 59808, 24576, 24576 * 8
+SIG = 54
+
+
+def signature(board, color):
+    c = lambda pt: len(board.pieces(pt, color))
+    return min(c(chess.KNIGHT), 2) * 18 + min(c(chess.BISHOP), 2) * 6 + min(c(chess.ROOK), 2) * 2 + min(c(chess.QUEEN), 1)
+
+
+def cell(board, persp):
+    return signature(board, persp) * SIG + signature(board, not persp)
+
+
+def pk_ref(board):
+    us = board.turn
+    flip = 0 if us == chess.WHITE else 56
+    out = [0 + (s ^ flip) for s in sorted(board.pieces(chess.PAWN, us))]
+    out += [64 + (s ^ flip) for s in sorted(board.pieces(chess.PAWN, not us))]
+    out += [128 + (board.king(us) ^ flip), 192 + (board.king(not us) ^ flip)]
+    return out + [-1] * (18 - len(out))
+
+
+def batch_tensors(feature, fens):
+    n = len(fens)
+    b = get_sparse_batch_from_fens(feature, fens, [0] * n, [40] * n, [0] * n)
+    t = b.contents.get_tensors("cpu")
+    out = tuple(x.clone() for x in t)
+    destroy_sparse_batch(b)
+    return out
+
+
+def main():
+    pgn = sys.argv[1]
+    npos = int(sys.argv[2]) if len(sys.argv) > 2 else 4000
+    random.seed(3)
+    fens = []
+    with open(pgn, encoding="utf-8", errors="replace") as f:
+        while len(fens) < npos:
+            g = chess.pgn.read_game(f)
+            if g is None:
+                break
+            board = g.board()
+            for i, mv in enumerate(g.mainline_moves()):
+                board.push(mv)
+                if random.random() < 0.08:
+                    fens.append(board.fen())
+    fens += [
+        "4k3/8/8/8/8/8/8/4K3 w - - 0 1",
+        "4k3/8/8/8/8/8/8/4K3 b - - 0 1",
+        "NNN1k3/8/8/8/8/8/8/QQ2K3 b - - 0 1",
+        "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR b KQkq - 0 1",
+        "4k3/1P6/8/8/8/8/6p1/4K3 w - - 0 1",
+        "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1",
+    ]
+    feat_x8 = "Full_Threats+HalfKAv2_hm_X8+PP_3Wide+PassedPawns"
+    feat_pl = "Full_Threats+HalfKAv2_hm+PP_3Wide+PassedPawns"
+    tx = batch_tensors(feat_x8, fens)
+    tp = batch_tensors(feat_pl, fens)
+    table = default_router_table().numpy()
+    bad_aux = bad_idx = bad_pk = 0
+    experts_seen = np.zeros(8, dtype=np.int64)
+    for i, fen in enumerate(fens):
+        board = chess.Board(fen)
+        aux = tx[7][i].tolist()
+        cw, cb = cell(board, chess.WHITE), cell(board, chess.BLACK)
+        if aux[0] != cw or aux[1] != cb:
+            bad_aux += 1
+            if bad_aux <= 5:
+                print("aux cell mismatch", fen, aux[:2], (cw, cb))
+        if aux[2:] != pk_ref(board):
+            bad_pk += 1
+            if bad_pk <= 5:
+                print("pawn-king mismatch", fen, aux[2:], pk_ref(board))
+        for persp, (xi, pi) in enumerate(((tx[2][i], tp[2][i]), (tx[3][i], tp[3][i]))):
+            e = int(table[cw if persp == 0 else cb])
+            experts_seen[e] += 1
+            for x, p in zip(xi.tolist(), pi.tolist()):
+                if p < 0:
+                    exp = -1
+                elif p < THREATS:
+                    exp = p
+                elif p < THREATS + HKA:
+                    exp = p + e * HKA
+                else:
+                    exp = p + (X8 - HKA)
+                if x != exp:
+                    bad_idx += 1
+                    if bad_idx <= 5:
+                        print("index mismatch", fen, persp, x, exp)
+    print(f"positions {len(fens)}: aux cell mismatches {bad_aux}, pawn-king mismatches {bad_pk}, "
+          f"feature index mismatches {bad_idx}; experts used per perspective {experts_seen.tolist()}")
+    print("GATE 2", "OK" if bad_aux == bad_pk == bad_idx == 0 else "FAILED")
+
+
+if __name__ == "__main__":
+    main()
diff -ruN -x .pgo a/c2_npm_quantiles.py b/c2_npm_quantiles.py
--- a/c2_npm_quantiles.py	1970-01-01 01:00:00.000000000 +0100
+++ b/c2_npm_quantiles.py	2026-10-21 13:17:11.718735000 +0200
@@ -0,0 +1,38 @@
+"""Opponent non-pawn material (capped signature) per perspective on game positions: histogram and 8 equal-frequency
+classes, for the initial routing table of Consilium-2 (21/10/2026). Usage: python c2_npm_quantiles.py a.pgn [b.pgn ...]"""
+import random
+import sys
+from collections import Counter
+
+import chess
+import chess.pgn
+
+
+def sig_npm(board, color):
+    c = lambda pt: min(len(board.pieces(pt, color)), 2 if pt != chess.QUEEN else 1)
+    return 3 * c(chess.KNIGHT) + 3 * c(chess.BISHOP) + 5 * c(chess.ROOK) + 9 * c(chess.QUEEN)
+
+
+random.seed(5)
+h = Counter()
+for path in sys.argv[1:]:
+    with open(path, encoding="utf-8", errors="replace") as f:
+        for _ in range(2500):
+            g = chess.pgn.read_game(f)
+            if g is None:
+                break
+            b = g.board()
+            for i, mv in enumerate(g.mainline_moves()):
+                b.push(mv)
+                if i >= 8:
+                    h[sig_npm(b, chess.BLACK)] += 1   # White's perspective: opponent = Black
+                    h[sig_npm(b, chess.WHITE)] += 1
+tot = sum(h.values())
+acc, cuts, k = 0, [], 1
+for v in sorted(h):
+    acc += h[v]
+    while k < 8 and acc >= tot * k / 8:
+        cuts.append(v)
+        k += 1
+print("histogram", {v: round(100 * h[v] / tot, 2) for v in sorted(h)})
+print("upper bounds of classes 0..6 (class 7 = above):", cuts)
