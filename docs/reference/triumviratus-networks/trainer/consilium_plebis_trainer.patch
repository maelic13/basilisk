--- a/model/modules/features/halfka_v2_hm_phase.py	1970-01-01 01:00:00.000000000 +0100
+++ b/model/modules/features/halfka_v2_hm_phase.py	2026-10-21 13:17:12.201161500 +0200
@@ -0,0 +1,110 @@
+"""HalfKAv2_hm_P4^ — HalfKA a ESPERTI per fase di gioco (Triumviratus, 28/09/2026). Idea nostra, non esiste in SF.
+
+Una "mixture of experts" dentro il feature transformer: i pesi HalfKA dipendono dal re (32 bucket, come HalfKA) E
+dalla fase, scelta dal numero di pezzi sulla scacchiera (NUM_PHASES fasce). L'accumulatore resta largo L1: la
+capacita' cresce di NUM_PHASES volte senza allargare L1 (niente -11%/-20% di NPS). Il motore ricalcola
+l'accumulatore quando una cattura fa cambiare fascia (tabelle Finny), come gia' fa quando il re cambia bucket.
+
+Pesi = DELTA per (fase, re) + BASE per re (comune a tutte le fasi) + VIRTUALE per piano (comune a tutto).
+La base e' inizializzata come una HalfKA normale e le delta a zero: all'epoca 0 la rete E' una HalfKA; le fasi si
+specializzano solo dove i dati lo chiedono. La base vede TUTTE le posizioni: e' la risposta al "ogni esperto vede
+un quarto dei dati".
+
+🔴 PHASE_OF_PIECECOUNT deve essere IDENTICA nel loader C++ (training_data_loader.cpp, HalfKAv2_hm_P4) e nel
+motore (nnue/nnue/features/half_ka_v2_hm_phase.*). Fasce provvisorie; da rifare a frequenza uguale sul corpus.
+"""
+import torch
+from torch import nn
+
+from .halfka_v2_hm import HalfKav2Hm, InverseKingBuckets
+from .input_feature import InputFeature
+
+NUM_PHASES = 4
+# pezzi sulla scacchiera (re compresi, 2..32) -> fase 0..3, a FREQUENZA UGUALE: i quartili dei 16 bin misurati in
+# docs/rete/PROSPETTIVE_RETE_7.0.md §15.2 (479.243 posizioni): <=9, 10-15, 16-23, >=24.
+# ⚠️ Da rifare sulla distribuzione EFFETTIVA del training (binpack x pesi pc_y del loader) prima del run.
+PHASE_OF_PIECECOUNT = [0] * 10 + [1] * 6 + [2] * 8 + [3] * 9  # indici 0..32
+assert len(PHASE_OF_PIECECOUNT) == 33
+
+
+class HalfKav2HmPhase(InputFeature):
+    HASH = 0x7F234CB8 ^ 0x50484134  # HalfKAv2_hm ^ "PHA4": deve coincidere col motore
+    FEATURE_NAME = "HalfKAv2_hm_P4^"
+    INPUT_FEATURE_NAME = "HalfKAv2_hm_P4"
+    MAX_ACTIVE_FEATURES = 32
+
+    NUM_PLANES = HalfKav2Hm.NUM_PLANES      # 768 (12 tipi di pezzo)
+    NUM_BUCKETS = HalfKav2Hm.NUM_BUCKETS    # 32 bucket del re
+    NUM_BASE = NUM_PLANES * NUM_BUCKETS     # 24.576 = una HalfKA
+    NUM_INPUTS = NUM_BASE * NUM_PHASES      # 98.304
+    NUM_REAL_FEATURES = 704 * 32 * NUM_PHASES  # export a 11 tipi di pezzo, come HalfKA
+
+    def __init__(self, num_outputs: int):
+        super().__init__()
+        self.num_outputs = num_outputs
+        self.weight = nn.Parameter(torch.zeros(self.NUM_INPUTS, num_outputs))           # delta per fase
+        self.base_weight = nn.Parameter(torch.empty(self.NUM_BASE, num_outputs))       # comune alle fasi
+        self.virtual_weight = nn.Parameter(torch.zeros(self.NUM_PLANES, num_outputs))  # comune a tutto
+        self.reset_parameters()
+
+    def reset_parameters(self):
+        sigma = (1 / self.NUM_BASE) ** 0.5  # come una HalfKA: la base e' la rete di partenza
+        with torch.no_grad():
+            self.base_weight.uniform_(-sigma, sigma)
+            self.weight.zero_()
+
+    def merged_weight(self) -> torch.Tensor:
+        return (self.weight + self.base_weight.repeat(NUM_PHASES, 1)
+                + self.virtual_weight.repeat(self.NUM_BUCKETS * NUM_PHASES, 1))
+
+    @torch.no_grad()
+    def coalesce(self) -> None:
+        self.weight.copy_(self.merged_weight())
+        self.base_weight.zero_()
+        self.virtual_weight.zero_()
+
+    @torch.no_grad()
+    def zero_virtual_weights(self) -> None:
+        self.virtual_weight.zero_()
+
+    @torch.no_grad()
+    def init_weights(self, num_psqt_buckets: int, nnue2score: float) -> None:
+        # PSQT iniziale sulla BASE (quindi uguale in tutte le fasi), delta a zero.
+        self.zero_virtual_weights()
+        L1 = self.num_outputs - num_psqt_buckets
+        vals = torch.tensor(HalfKav2Hm.halfka_psqts(), device=self.base_weight.device,
+                            dtype=self.base_weight.dtype) / nnue2score
+        for i in range(num_psqt_buckets):
+            self.base_weight[:, L1 + i] = vals
+            self.weight[:, L1 + i] = 0.0
+
+    @torch.no_grad()
+    def get_export_weights(self) -> torch.Tensor:
+        """Pesi fusi, rimappati da 12 a 11 tipi di pezzo per ogni (fase, bucket del re): stesso schema di HalfKA."""
+        merged = self.merged_weight()
+        export = merged.new_zeros(self.NUM_REAL_FEATURES, merged.shape[1])
+        for ph in range(NUM_PHASES):
+            for b in range(self.NUM_BUCKETS):
+                src = (ph * self.NUM_BUCKETS + b) * self.NUM_PLANES
+                dst = (ph * self.NUM_BUCKETS + b) * 704
+                export[dst: dst + 640] = merged[src: src + 640]
+                ksq = InverseKingBuckets[b]
+                export[dst + 640: dst + 704] = merged[src + 11 * 64: src + 12 * 64]  # re avversario
+                export[dst + 640 + ksq] = merged[src + 10 * 64 + ksq]                # re proprio
+        return export
+
+    @torch.no_grad()
+    def load_export_weights(self, export_weight: torch.Tensor) -> None:
+        expanded = export_weight.new_zeros(self.NUM_INPUTS, export_weight.shape[1])
+        for ph in range(NUM_PHASES):
+            for b in range(self.NUM_BUCKETS):
+                src = (ph * self.NUM_BUCKETS + b) * 704
+                dst = (ph * self.NUM_BUCKETS + b) * self.NUM_PLANES
+                expanded[dst: dst + 640] = export_weight[src: src + 640]
+                ksq = InverseKingBuckets[b]
+                expanded[dst + 10 * 64 + ksq] = export_weight[src + 640 + ksq]
+                expanded[dst + 11 * 64: dst + 12 * 64] = export_weight[src + 640: src + 704]
+                expanded[dst + 11 * 64 + ksq] = 0
+        self.weight.data.copy_(expanded)
+        self.base_weight.data.zero_()
+        self.virtual_weight.data.zero_()
diff -ruN -x .pgo a/model/modules/features/halfka_v2_hm_x.py b/model/modules/features/halfka_v2_hm_x.py
--- a/model/modules/features/halfka_v2_hm_x.py	1970-01-01 01:00:00.000000000 +0100
+++ b/model/modules/features/halfka_v2_hm_x.py	2026-10-21 13:17:12.215747600 +0200
@@ -0,0 +1,147 @@
+"""HalfKAv2_hm_X8^ -- Consilium-2 (Triumviratus, 21/10/2026; docs/rete/PROGETTO_NUOVA_RETE_2026-10-21.md §5).
+
+Input buckets on the first layer ("experts", our Consilium) chosen PER PERSPECTIVE by a routing table over the
+non-pawn material signature, instead of fixed piece-count bands:
+
+    signature(c) = min(N,2)*18 + min(B,2)*6 + min(R,2)*2 + min(Q,1)      54 values
+    cell(p)      = signature(p) * 54 + signature(opponent of p)          2,916 cells
+    expert(p)    = router[cell(p)]                                       0..7
+
+Pawn captures never change a cell, and the table decides which non-pawn captures change the expert. The table is
+learned while training (trainer/router_em.py: hard EM with a budget on how often captures change the expert) and
+stored in the .nnue file; the data loader computes the index with the same table (set_router_table).
+
+Weights = per-expert DELTA + BASE per king bucket (shared by the experts) + VIRTUAL per plane (shared by all), as in
+HalfKAv2_hm_P4. The merged weights are exported as int8 at the scale of the threat rows (+-127/256): clip_weights
+clamps the merged value (delta + base + virtual) and puts the excess back into the delta, as nnue-pytorch #542 does
+for the virtual weights. The PSQT columns are not clamped (they are exported as int32).
+"""
+import torch
+from torch import nn
+
+from .halfka_v2_hm import HalfKav2Hm, InverseKingBuckets
+from .input_feature import InputFeature
+
+NUM_EXPERTS = 8
+SIG = 54
+NUM_CELLS = SIG * SIG
+
+
+def npm_of_signature(s: int) -> int:
+    return 3 * (s // 18) + 3 * ((s // 6) % 3) + 5 * ((s // 2) % 3) + 9 * (s % 2)
+
+
+DEFAULT_UPPER = (3, 5, 8, 9, 13, 18, 25)   # opponent NPM, 8 equal-frequency classes (game positions, 21/10/2026)
+
+
+def default_router_table() -> torch.Tensor:
+    """Opponent's non-pawn material in 8 equal-frequency classes: the starting point of the learned routing, which
+    may then use the own material too. IDENTICAL to router::default_expert in the data loader."""
+    t = torch.zeros(NUM_CELLS, dtype=torch.uint8)
+    for c in range(NUM_CELLS):
+        opp = npm_of_signature(c % SIG)
+        t[c] = sum(opp > u for u in DEFAULT_UPPER)
+    return t
+
+
+class HalfKav2HmX(InputFeature):
+    HASH = 0x7F234CB8 ^ 0x58384331  # HalfKAv2_hm ^ "X8C1": must match the engine (consilium/cn.cpp)
+    FEATURE_NAME = "HalfKAv2_hm_X8^"
+    INPUT_FEATURE_NAME = "HalfKAv2_hm_X8"
+    MAX_ACTIVE_FEATURES = 32
+    EXPORT_WEIGHT_DTYPE = torch.int8
+
+    NUM_PLANES = HalfKav2Hm.NUM_PLANES      # 768
+    NUM_BUCKETS = HalfKav2Hm.NUM_BUCKETS    # 32 king buckets
+    NUM_BASE = NUM_PLANES * NUM_BUCKETS     # 24,576 = one HalfKA
+    NUM_INPUTS = NUM_BASE * NUM_EXPERTS     # 196,608
+    NUM_REAL_FEATURES = 704 * 32 * NUM_EXPERTS
+
+    def __init__(self, num_outputs: int):
+        super().__init__()
+        self.num_outputs = num_outputs
+        self.weight = nn.Parameter(torch.zeros(self.NUM_INPUTS, num_outputs))           # delta per expert
+        self.base_weight = nn.Parameter(torch.empty(self.NUM_BASE, num_outputs))       # shared by the experts
+        self.virtual_weight = nn.Parameter(torch.zeros(self.NUM_PLANES, num_outputs))  # shared by all
+        self.register_buffer("router", default_router_table())                         # cell -> expert
+        self.reset_parameters()
+
+    def reset_parameters(self):
+        sigma = (1 / self.NUM_BASE) ** 0.5
+        with torch.no_grad():
+            self.base_weight.uniform_(-sigma, sigma)
+            self.weight.zero_()
+
+    def merged_weight(self) -> torch.Tensor:
+        return (self.weight + self.base_weight.repeat(NUM_EXPERTS, 1)
+                + self.virtual_weight.repeat(self.NUM_BUCKETS * NUM_EXPERTS, 1))
+
+    @torch.no_grad()
+    def coalesce(self) -> None:
+        self.weight.copy_(self.merged_weight())
+        self.base_weight.zero_()
+        self.virtual_weight.zero_()
+
+    @torch.no_grad()
+    def zero_virtual_weights(self) -> None:
+        self.virtual_weight.zero_()
+
+    @torch.no_grad()
+    def clip_weights(self, quantization) -> None:
+        """Merged int8 weights inside +-127/256 (the L1 columns only); the excess goes back into the deltas."""
+        lo, hi = quantization.min_threat_weight, quantization.max_threat_weight
+        L1 = self.num_outputs - quantization_num_psqt(self)
+        shared = (self.base_weight[:, :L1].view(self.NUM_BUCKETS, self.NUM_PLANES, L1)
+                  + self.virtual_weight[:, :L1].view(1, self.NUM_PLANES, L1))
+        d = self.weight.data[:, :L1].view(NUM_EXPERTS, self.NUM_BUCKETS, self.NUM_PLANES, L1)
+        for e in range(NUM_EXPERTS):   # one expert at a time: no temporary of the whole table
+            m = d[e] + shared
+            m.clamp_(lo, hi)
+            d[e].copy_(m - shared)
+
+    @torch.no_grad()
+    def init_weights(self, num_psqt_buckets: int, nnue2score: float) -> None:
+        self.zero_virtual_weights()
+        self._num_psqt = num_psqt_buckets
+        L1 = self.num_outputs - num_psqt_buckets
+        vals = torch.tensor(HalfKav2Hm.halfka_psqts(), device=self.base_weight.device,
+                            dtype=self.base_weight.dtype) / nnue2score
+        for i in range(num_psqt_buckets):
+            self.base_weight[:, L1 + i] = vals
+            self.weight[:, L1 + i] = 0.0
+
+    @torch.no_grad()
+    def get_export_weights(self) -> torch.Tensor:
+        """Merged weights, remapped from 12 to 11 piece types for every (expert, king bucket), as HalfKA."""
+        merged = self.merged_weight()
+        export = merged.new_zeros(self.NUM_REAL_FEATURES, merged.shape[1])
+        for ex in range(NUM_EXPERTS):
+            for b in range(self.NUM_BUCKETS):
+                src = (ex * self.NUM_BUCKETS + b) * self.NUM_PLANES
+                dst = (ex * self.NUM_BUCKETS + b) * 704
+                export[dst: dst + 640] = merged[src: src + 640]
+                ksq = InverseKingBuckets[b]
+                export[dst + 640: dst + 704] = merged[src + 11 * 64: src + 12 * 64]  # enemy king
+                export[dst + 640 + ksq] = merged[src + 10 * 64 + ksq]                # own king
+        return export
+
+    @torch.no_grad()
+    def load_export_weights(self, export_weight: torch.Tensor) -> None:
+        expanded = export_weight.new_zeros(self.NUM_INPUTS, export_weight.shape[1])
+        for ex in range(NUM_EXPERTS):
+            for b in range(self.NUM_BUCKETS):
+                src = (ex * self.NUM_BUCKETS + b) * 704
+                dst = (ex * self.NUM_BUCKETS + b) * self.NUM_PLANES
+                expanded[dst: dst + 640] = export_weight[src: src + 640]
+                ksq = InverseKingBuckets[b]
+                expanded[dst + 10 * 64 + ksq] = export_weight[src + 640 + ksq]
+                expanded[dst + 11 * 64: dst + 12 * 64] = export_weight[src + 640: src + 704]
+                expanded[dst + 11 * 64 + ksq] = 0
+        self.weight.data.copy_(expanded)
+        self.base_weight.data.zero_()
+        self.virtual_weight.data.zero_()
+
+
+def quantization_num_psqt(feature: HalfKav2HmX) -> int:
+    """PSQT columns of the feature's weight matrix (set by init_weights; 8 in every network of the project)."""
+    return getattr(feature, "_num_psqt", 8)
