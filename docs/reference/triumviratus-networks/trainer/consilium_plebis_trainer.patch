+"""Graft del blocco Mobility su una rete gia' allenata (Triumviratus 8.0, 29/09/2026).
+
+    python graft_mobility.py IN.pt OUT.pt [--random-scale S]
+
+IN.pt  : modello NNUE serializzato (serialize.py last.ckpt IN.pt), feature senza Mobility.
+OUT.pt : stesso modello con "+Mobility" in coda alla feature string. Tutti i pesi copiati;
+         il blocco Mobility e' a ZERO, quindi OUT valuta esattamente come IN (graft neutro).
+--random-scale S : invece dello zero, pesi Mobility casuali uniformi in [-S, S] (e PSQT a
+         zero). Serve SOLO per il gate motore == trainer (cross_check_eval.py): con pesi zero
+         un errore di indice nel blocco sarebbe invisibile.
+
+Poi il training del solo blocco:
+    NNUE_TRAIN_ONLY=Mobility python train.py ... --resume-from-model OUT.pt \
+        --features "<feature di IN>+Mobility"
+"""
+
+import argparse
+import dataclasses
+
+import torch
+
+import model as M
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("src")
+    ap.add_argument("dst")
+    ap.add_argument("--random-scale", type=float, default=0.0)
+    args = ap.parse_args()
+
+    old = torch.load(args.src, weights_only=False, map_location="cpu")
+    old_features = old.config.features
+    if "Mobility" in old_features.split("+"):
+        raise SystemExit(f"{args.src} ha gia' il blocco Mobility: {old_features}")
+    new_features = old_features + "+Mobility"
+
+    config = dataclasses.replace(old.config, features=new_features)
+    new = M.NNUE(config=config)
+
+    old_sd = {k.replace("_orig_mod.", ""): v for k, v in old.model.state_dict().items()}
+    missing, unexpected = new.model.load_state_dict(old_sd, strict=False)
+    mob_index = len(new.model.input.features) - 1
+    expected_missing = {f"input.features.{mob_index}.weight"}
+    if set(missing) != expected_missing or unexpected:
+        raise SystemExit(f"graft inatteso: missing={missing} unexpected={unexpected}")
+
+    mob = new.model.input.features[mob_index]
+    with torch.no_grad():
+        if args.random_scale > 0:
+            g = torch.Generator().manual_seed(1)
+            mob.weight.uniform_(-args.random_scale, args.random_scale, generator=g)
+            mob.weight[:, new.model.L1:] = 0.0
+        else:
+            mob.weight.zero_()
+
+    # Controllo: stessi tensori copiati bit per bit.
+    new_sd = new.model.state_dict()
+    for k, v in old_sd.items():
+        if not torch.equal(new_sd[k], v):
+            raise SystemExit(f"copia non identica: {k}")
+
+    torch.save(new, args.dst)
+    print(f"{args.src} ({old_features}) -> {args.dst} ({new_features}), "
+          f"Mobility {'random +-' + str(args.random_scale) if args.random_scale > 0 else 'a zero'}")
+
+
+if __name__ == "__main__":
+    main()
