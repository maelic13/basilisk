+++ b/c2_transitions.py	2026-10-21 13:17:11.742498300 +0200
@@ -0,0 +1,106 @@
+"""Capture transitions between routing cells (Consilium-2, 21/10/2026), for the budget of the learned routing.
+
+For a sample of game positions, every legal capture and promotion is played and, for each perspective, the pair
+(cell before, cell after) is counted. Pawn captures give self-transitions (they count as captures that cannot change
+the expert). The quiescence search evaluates mostly captures, so this is the case that costs accumulator rebuilds.
+Also prints the crossing rate (changes of expert per capture, summed over the two perspectives) of the default table
+and of today's piece-count bands for reference.
+
+Usage: python c2_transitions.py out.npz game1.pgn [game2.pgn ...] [--games-per-file 1500] [--skip 8]
+"""
+import argparse
+import random
+from collections import Counter
+
+import chess
+import chess.pgn
+import numpy as np
+
+SIG = 54
+
+
+def signature(board, color):
+    n = len(board.pieces(chess.KNIGHT, color))
+    b = len(board.pieces(chess.BISHOP, color))
+    r = len(board.pieces(chess.ROOK, color))
+    q = len(board.pieces(chess.QUEEN, color))
+    return min(n, 2) * 18 + min(b, 2) * 6 + min(r, 2) * 2 + min(q, 1)
+
+
+def cell(board, persp):
+    return signature(board, persp) * SIG + signature(board, not persp)
+
+
+def npm_of_signature(s):
+    return 3 * (s // 18) + 3 * ((s // 6) % 3) + 5 * ((s // 2) % 3) + 9 * (s % 2)
+
+
+def default_table():   # IDENTICAL to router::default_expert (data loader) and default_router_table (Python)
+    upper = (3, 5, 8, 9, 13, 18, 25)
+    t = np.zeros(SIG * SIG, dtype=np.int64)
+    for c in range(SIG * SIG):
+        opp = npm_of_signature(c % SIG)
+        t[c] = sum(opp > u for u in upper)
+    return t
+
+
+def band(n):
+    return 0 if n <= 9 else 1 if n <= 15 else 2 if n <= 23 else 3
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("out")
+    ap.add_argument("pgns", nargs="+")
+    ap.add_argument("--games-per-file", type=int, default=1500)
+    ap.add_argument("--skip", type=int, default=8)
+    a = ap.parse_args()
+    random.seed(1)
+    T = Counter()
+    today_cross = today_n = 0
+    for path in a.pgns:
+        offsets = []
+        with open(path, encoding="utf-8", errors="replace") as f:
+            while True:
+                off = f.tell()
+                line = f.readline()
+                if not line:
+                    break
+                if line.startswith("[Event "):
+                    offsets.append(off)
+        with open(path, encoding="utf-8", errors="replace") as f:
+            for off in sorted(random.sample(offsets, min(a.games_per_file, len(offsets)))):
+                f.seek(off)
+                g = chess.pgn.read_game(f)
+                if g is None:
+                    continue
+                board = g.board()
+                for ply, mv in enumerate(g.mainline_moves()):
+                    board.push(mv)
+                    if ply < a.skip:
+                        continue
+                    before = (cell(board, chess.WHITE), cell(board, chess.BLACK))
+                    pcs = len(board.piece_map())
+                    for m in board.legal_moves:
+                        if not (board.is_capture(m) or m.promotion):
+                            continue
+                        board.push(m)
+                        after = (cell(board, chess.WHITE), cell(board, chess.BLACK))
+                        T[(before[0], after[0])] += 1
+                        T[(before[1], after[1])] += 1
+                        today_cross += 2 * (band(len(board.piece_map())) != band(pcs))
+                        today_n += 1
+                        board.pop()
+    src = np.array([k[0] for k in T], dtype=np.int64)
+    dst = np.array([k[1] for k in T], dtype=np.int64)
+    w = np.array([T[k] for k in T], dtype=np.float64)
+    np.savez(a.out, src=src, dst=dst, w=w)
+    t = default_table()
+    cross = float((w * (t[src] != t[dst])).sum() / w.sum()) * 2   # per capture, summed over the two perspectives
+    print(f"captures {today_n}, distinct transitions {len(w)}")
+    print(f"crossing per capture (two perspectives): today's bands {today_cross / max(today_n, 1):.4f}, "
+          f"default table {cross:.4f}")
+
+
+if __name__ == "__main__":
+    main()
