+"""Loss di piu' reti sulle STESSE posizioni con lambda FISSO (29/09/2026).
+
+La train/val loss del log non confronta le epoche: il run usa un ciclo di lambda (1,0 -> 0,7 all'epoca ~112 ->
+di nuovo 1,0 a fine run), e la loss cambia con il bersaglio. Qui ogni rete e' valutata sugli stessi batch con
+lambda 1,0 (solo eval dei dati), 0,0 (solo risultato della partita) e 0,85, con i LossParams di default del run.
+USO: python val_loss_fixed.py <dati.binpack> <rete.nnue> [<rete.nnue> ...] [--batches N] [--features F]
+"""
+import argparse
+import os
+
+import torch
+
+import data_loader
+import model as M
+from model.nnue import calculate_sf_loss
+
+FEATURES = "Full_Threats+HalfKAv2_hm_P4^+PP_3Wide+PassedPawns"
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("data")
+    ap.add_argument("nets", nargs="+")
+    ap.add_argument("--batches", type=int, default=100)
+    ap.add_argument("--batch-size", type=int, default=4096)
+    ap.add_argument("--features", default=FEATURES)
+    ap.add_argument("--threads", type=int, default=8)
+    args = ap.parse_args()
+    torch.set_num_threads(args.threads)
+
+    cfg = M.NNUELightningConfig(features=args.features, model_config=M.ModelConfig(L1=1024))
+    nets = []
+    for p in args.nets:
+        with open(p, "rb") as f:
+            m = M.NNUEReader(f, cfg.features, cfg.model_config).model
+        m.eval()
+        nets.append((os.path.basename(p), m))
+    feature_set = nets[0][1].input_feature_name
+
+    provider = data_loader.SparseBatchProvider(
+        feature_set=feature_set,
+        filenames=[args.data],
+        cyclic=True,
+        num_workers=2,
+        batch_size=args.batch_size,
+        config=data_loader.DataloaderSkipConfig(random_fen_skipping=10, filtered=True),
+    )
+    lambdas = (1.0, 0.85, 0.75, 0.0)
+    sums = {name: [0.0] * len(lambdas) for name, _ in nets}
+    with torch.no_grad():
+        for i in range(args.batches):
+            us, them, wi, bi, outcome, score, pc = next(provider)
+            for name, m in nets:
+                scorenet = m(us, them, wi, bi, pc, True, True) * m.quantization.nnue2score
+                for k, lam in enumerate(lambdas):
+                    sums[name][k] += calculate_sf_loss(scorenet, score, outcome, cfg.loss_params, lam).item()
+            if (i + 1) % 10 == 0:
+                print(f"batch {i + 1}/{args.batches}", flush=True)
+
+    n = args.batches
+    print(f"\n{args.batches} batch x {args.batch_size} posizioni da {os.path.basename(args.data)}")
+    print(f"{'rete':<34}" + "".join(f"  lambda {lam:<5}" for lam in lambdas))
+    for name, _ in nets:
+        print(f"{name:<34}" + "".join(f"  {s / n * 1e3:>9.4f}e-3" for s in sums[name]))
+
+
+if __name__ == "__main__":
+    main()
