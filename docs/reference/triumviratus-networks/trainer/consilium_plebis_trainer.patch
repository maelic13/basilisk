+"""Learned routing of the Consilium-2 experts (Triumviratus, 21/10/2026; docs/rete/PROGETTO_NUOVA_RETE_2026-10-21.md §5).
+
+The experts of HalfKAv2_hm_X8 are chosen per perspective by a table cell -> expert (cell = non-pawn material
+signature of the perspective and of its opponent). This callback learns the table by hard EM while the network trains:
+
+  E-step   during the epochs listed in `epochs`, a sample of the training positions is kept (CPU copies). At the end of
+           such an epoch, for every sampled position and perspective, the loss is computed again with that
+           perspective's HalfKA indices moved to each of the 8 experts (the other perspective unchanged). The loss
+           differences are summed per (cell, expert) on every rank, then all-reduced.
+  M-step   cells are reassigned to minimise the summed loss, under two constraints:
+             - budget: the share of captures that change the expert of a perspective (summed over the two
+               perspectives, the unit of the design document: 0.262 for today's piece-count bands) stays <= `budget`;
+               capture transitions between cells come from game positions (tools: c2_transitions.py);
+             - every expert keeps at least `min_share` of the sampled positions; at most `max_move_share` of them
+               change expert in one round (the shared base weights keep the move gentle).
+           The penalty weight is found by bisection; the local search is a deterministic sweep (rank 0 decides, the
+           table is broadcast so every rank and every data loader use the same one).
+  Then     the table is written into the network (feature buffer `router`, saved in checkpoints and in the .nnue) and
+           into the data loader (set_router_table). Batches already queued keep the previous table.
+
+Log of every round (table, loss gain, crossing rate, shares): <log_dir>/router_em.jsonl.
+"""
+import json
+import os
+
+import numpy as np
+import torch
+import torch.distributed as dist
+
+from data_loader._native import set_router_table
+from model.modules.features.halfka_v2_hm_x import NUM_CELLS, NUM_EXPERTS, HalfKav2HmX
+from model.nnue import remap_tablebase_score
+
+from .callbacks import Callback
+
+
+def _inner(model):
+    m = model.model
+    return getattr(m, "_orig_mod", m)
+
+
+def _x8_feature(inner):
+    off = 0
+    for f in inner.input.features:
+        if isinstance(f, HalfKav2HmX):
+            return f, off
+        off += f.NUM_INPUTS
+    raise RuntimeError("RouterEM needs the HalfKAv2_hm_X8^ feature")
+
+
+def _per_sample_loss(nnue, inner, batch, current_step):
+    """The training loss of nnue.compute_loss_with_scorenet, per position (weighted, not normalised)."""
+    us, them, w, b, outcome, score, piece_count, aux = batch
+    scorenet = inner(us, them, w, b, piece_count, nnue.config.use_fake_act_quantization,
+                     nnue.config.use_fake_weight_quantization, aux)
+    scorenet = scorenet * inner.quantization.nnue2score
+    p = nnue.config.loss_params
+    lam = nnue.lambda_scheduler(loss_params=p, current_step=current_step, max_steps=nnue.max_steps,
+                                is_training=False, scorenet=scorenet)
+    score = remap_tablebase_score(score, base=p.tb_remap_base, scale=p.tb_remap_scale, decay=p.tb_remap_decay)
+    q = (scorenet - p.in_offset) / p.in_scaling
+    qm = (-scorenet - p.in_offset) / p.in_scaling
+    qf = 0.5 * (1.0 + q.sigmoid() - qm.sigmoid())
+    s = (score - p.out_offset) / p.out_scaling
+    sm = (-score - p.out_offset) / p.out_scaling
+    pf = 0.5 * (1.0 + s.sigmoid() - sm.sigmoid())
+    pt = pf * lam + outcome * (1.0 - lam)
+    loss = torch.pow(torch.abs(pt - qf), p.pow_exp)
+    if p.qp_asymmetry != 0.0:
+        loss = loss * ((qf > pt) * p.qp_asymmetry + 1)
+    weights = 1 + (2.0 ** p.w1 - 1) * torch.pow((pf - 0.5) ** 2 * pf * (1 - pf), p.w2)
+    return (loss * weights).view(-1), weights.view(-1)
+
+
+def assign(D, N, cur, trans, budget, min_share, max_move_share, min_cell_samples, iters=14):
+    """M-step. D[c, e] = summed loss change if cell c used expert e (0 at the current expert); N[c] = samples;
+    cur[c] = current expert; trans = (src, dst, weight) capture transitions between cells, one entry per perspective
+    (self-transitions included: they count captures that cannot change the expert). Returns the new table."""
+    C, K = D.shape
+    src, dst, wt = trans
+    wsum = float(wt.sum()) if len(wt) else 1.0
+    ntot = float(N.sum()) if N.sum() > 0 else 1.0
+    nbr = [[] for _ in range(C)]          # undirected neighbours with weights (crossing counted once per edge)
+    for s_, d_, w_ in zip(src, dst, wt):
+        if s_ != d_:
+            nbr[s_].append((d_, w_))
+            nbr[d_].append((s_, w_))
+
+    def crossing(t):   # expert changes per capture, summed over the two perspectives (each capture = 2 entries)
+        if not len(wt):
+            return 0.0
+        return 2.0 * float((wt * (t[src] != t[dst])).sum()) / wsum
+
+    movable = [c for c in np.argsort(-N, kind="stable") if N[c] >= min_cell_samples]
+
+    def local_search(mu):
+        t = cur.copy()
+        share = np.bincount(t, weights=N, minlength=K) / ntot
+        moved = 0.0
+        for _sweep in range(8):
+            changed = False
+            for c in movable:
+                e0 = t[c]
+                best_e, best_gain = e0, 0.0
+                for e in range(K):
+                    if e == e0:
+                        continue
+                    if share[e0] - N[c] / ntot < min_share:
+                        break
+                    if (cur[c] == e0 and e != cur[c]) and moved + N[c] / ntot > max_move_share:
+                        continue
+                    dl = (D[c, e] - D[c, e0]) / ntot
+                    dx = sum(w_ * (int(e != t[o]) - int(e0 != t[o])) for o, w_ in nbr[c]) / wsum
+                    g = dl + mu * dx
+                    if g < best_gain - 1e-12:
+                        best_e, best_gain = e, g
+                if best_e != e0:
+                    share[e0] -= N[c] / ntot
+                    share[best_e] += N[c] / ntot
+                    if cur[c] == e0:
+                        moved += N[c] / ntot
+                    elif cur[c] == best_e:
+                        moved -= N[c] / ntot
+                    t[c] = best_e
+                    changed = True
+            if not changed:
+                break
+        return t
+
+    t = local_search(0.0)
+    if crossing(t) <= budget:
+        return t, 0.0
+    lo, hi = 0.0, 1.0
+    while crossing(local_search(hi)) > budget and hi < 1e6:
+        hi *= 4.0
+    best = local_search(hi)
+    for _ in range(iters):
+        mid = 0.5 * (lo + hi)
+        tm = local_search(mid)
+        if crossing(tm) <= budget:
+            hi, best = mid, tm
+        else:
+            lo = mid
+    return best, hi
+
+
+class RouterEM(Callback):
+    def __init__(self, epochs, budget, transitions_path, log_dir, sample_batches=64, sample_size=16384,
+                 min_share=0.04, max_move_share=0.15, min_cell_samples=2000):
+        self.epochs = sorted(set(int(e) for e in epochs))
+        self.budget = budget
+        self.log_path = os.path.join(log_dir, "router_em.jsonl")
+        self.sample_batches = sample_batches
+        self.sample_size = sample_size
+        self.min_share = min_share
+        self.max_move_share = max_move_share
+        self.min_cell_samples = min_cell_samples
+        z = np.load(transitions_path)
+        self.trans = (z["src"].astype(np.int64), z["dst"].astype(np.int64), z["w"].astype(np.float64))
+        self.buf = []
+        self.stride = 1
+
+    def _round_this_epoch(self, trainer):
+        return (trainer.current_epoch + 1) in self.epochs
+
+    def on_train_start(self, trainer):
+        # The loader must route with the network's table (default, or the one restored from a checkpoint).
+        feat, _ = _x8_feature(_inner(trainer.model))
+        set_router_table(feat.router.detach().cpu().numpy())
+        n = max(1, getattr(trainer, "num_training_batches", 0) or 1)
+        self.stride = max(1, n // max(1, self.sample_batches))
+
+    def on_train_batch_end(self, trainer, batch, batch_idx, outputs):
+        if not self._round_this_epoch(trainer) or len(self.buf) >= self.sample_batches:
+            return
+        if batch_idx % self.stride:
+            return
+        k = min(self.sample_size, batch[0].shape[0])
+        self.buf.append(tuple(t[:k].detach().to("cpu", copy=True) for t in batch))
+
+    @torch.no_grad()
+    def on_train_epoch_end(self, trainer):
+        if not self._round_this_epoch(trainer):
+            return
+        nnue = trainer.model
+        inner = _inner(nnue)
+        feat, off = _x8_feature(inner)
+        base = feat.NUM_BASE
+        dev = next(inner.parameters()).device
+        D = torch.zeros(NUM_CELLS, NUM_EXPERTS, dtype=torch.float64, device=dev)
+        N = torch.zeros(NUM_CELLS, dtype=torch.float64, device=dev)
+        loss_sum = torch.zeros((), dtype=torch.float64, device=dev)
+        was_training = inner.training
+        inner.eval()
+        for cpu_batch in self.buf:
+            batch = tuple(t.to(dev, non_blocking=True) for t in cpu_batch)
+            us, them, w, b, outcome, score, pc, aux = batch
+            l0, wts = _per_sample_loss(nnue, inner, batch, trainer.global_step)
+            loss_sum += l0.sum().double()
+            for persp, idx in ((0, w), (1, b)):
+                cells = aux[:, persp].long()
+                inblock = (idx >= off) & (idx < off + NUM_EXPERTS * base)
+                rel = (idx - off) % base
+                N.index_add_(0, cells, torch.ones_like(cells, dtype=torch.float64))
+                for e in range(NUM_EXPERTS):
+                    moved = torch.where(inblock, off + e * base + rel, idx)
+                    bb = (us, them, moved, b, outcome, score, pc, aux) if persp == 0 else \
+                         (us, them, w, moved, outcome, score, pc, aux)
+                    le, _ = _per_sample_loss(nnue, inner, bb, trainer.global_step)
+                    D[:, e].index_add_(0, cells, (le - l0).double())
+        if was_training:
+            inner.train()
+        if dist.is_available() and dist.is_initialized():
+            dist.all_reduce(D)
+            dist.all_reduce(N)
+            dist.all_reduce(loss_sum)
+        cur = feat.router.detach().cpu().numpy().astype(np.int64)
+        table = torch.from_numpy(cur.astype(np.uint8))
+        info = {}
+        if trainer.rank == 0:
+            Dn, Nn = D.cpu().numpy(), N.cpu().numpy()
+            new, mu = assign(Dn, Nn, cur, self.trans, self.budget, self.min_share, self.max_move_share,
+                             self.min_cell_samples)
+            src, dst, wt = self.trans
+            cross = lambda t: 2.0 * float((wt * (t[src] != t[dst])).sum() / max(wt.sum(), 1e-9))
+            gain = float(sum(Dn[c, new[c]] for c in range(NUM_CELLS)) / max(Nn.sum(), 1.0))
+            info = {
+                "epoch": trainer.current_epoch + 1, "step": trainer.global_step, "samples": float(Nn.sum()),
+                "mean_loss": float(loss_sum.item() / max(Nn.sum() / 2, 1.0)), "loss_gain": gain,
+                "crossing_before": cross(cur), "crossing_after": cross(new), "mu": mu,
+                "cells_moved": int((new != cur).sum()),
+                "share_moved": float(Nn[new != cur].sum() / max(Nn.sum(), 1.0)),
+                "shares": (np.bincount(new, weights=Nn, minlength=NUM_EXPERTS) / max(Nn.sum(), 1.0)).tolist(),
+                "table": new.astype(int).tolist(),
+            }
+            table = torch.from_numpy(new.astype(np.uint8))
+        if dist.is_available() and dist.is_initialized():
+            t_dev = table.to(dev)
+            dist.broadcast(t_dev, src=0)
+            table = t_dev.cpu()
+        feat.router.copy_(table.to(feat.router.device))
+        set_router_table(table.numpy())
+        if trainer.rank == 0:
+            os.makedirs(os.path.dirname(self.log_path), exist_ok=True)
+            with open(self.log_path, "a", encoding="utf-8") as f:
+                f.write(json.dumps(info) + "\n")
+            print(f"[RouterEM] epoch {info['epoch']}: loss gain {info['loss_gain']:.3e}, crossing "
+                  f"{info['crossing_before']:.4f} -> {info['crossing_after']:.4f}, cells moved {info['cells_moved']}, "
+                  f"share moved {info['share_moved']:.3f}", flush=True)
+        self.buf = []
