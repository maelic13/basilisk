+// Ripartizione dei thread fra chi DECODIFICA il binpack (reader) e chi ESTRAE le feature
+// (worker). Il valore upstream, 0.14, e' tarato sul costo di estrazione di upstream; il
+// nostro feature set e' molto piu' pesante (Full_Threats 128 attive + PP_3Wide 128 +
+// PassedPawns) a parita' di costo di lettura, quindi l'ottimo si sposta verso i worker.
+// Reso regolabile a runtime con NNUE_WORKER_THREAD_RATIO per poter fare uno sweep senza
+// ricompilare: 0 < ratio < 1. Fuori range o non impostata => il default compilato.
+static double effective_worker_thread_ratio(double compiled_default) {
+    static const double cached = [compiled_default]() {
+        const char* env = std::getenv("NNUE_WORKER_THREAD_RATIO");
+        if (env == nullptr)
+            return compiled_default;
+        const double v = std::atof(env);
+        if (!(v > 0.0) || !(v < 1.0))
+        {
+            std::cerr << "NNUE_WORKER_THREAD_RATIO='" << env
+                      << "' fuori range (0,1): uso il default " << compiled_default << std::endl;
+            return compiled_default;
+        }
+        std::cerr << "NNUE_WORKER_THREAD_RATIO=" << v << " (default compilato "
+                  << compiled_default << ")" << std::endl;
+        return v;
+    }();
+    return cached;
+}
