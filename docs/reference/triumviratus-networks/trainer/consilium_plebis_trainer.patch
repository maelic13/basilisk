@@ -0,0 +1,87 @@
+"""Pawn-king subnetwork (Triumviratus, Consilium-2, 21/10/2026; docs/rete/PROGETTO_NUOVA_RETE_2026-10-21.md §6).
+
+A small non-linear network over the pawns and kings only, seen from the side to move (board flipped vertically when
+Black moves, no horizontal mirror):
+    inputs 0..63 own pawns, 64..127 enemy pawns, 128..191 own king, 192..255 enemy king (at most 18 active)
+    h   = clamp(b1 + sum of W1 rows, 0, 127/128)               H values
+    out = b2 + W2 h                                            L2 values, ADDED to the output of the first layer of
+                                                               the layer stack (before its activations and the skip)
+Its output depends only on pawns, kings and side to move, so the engine keeps it in a small per-thread cache keyed by
+them and computes it on a miss. It reads no feature-transformer row.
+
+Integer form used by the engine (exact when the weights sit on their grid, which fake quantization keeps):
+    W1, b1 int16 at x128, h = clamp(acc, 0, 127) (uint8, units of 1/128)
+    W2 int8 at x128 (|w| <= 127), b2 int32 at x128x128: out is in the units of the l1 accumulators (x128x128).
+W2 starts at zero, so a fresh network starts exactly as one without the subnetwork.
+Prior art: a cached pawn-king network concatenated after a hidden layer was proposed by Alvin Peng (TalkChess,
+22/04/2022); no published measurement found.
+"""
+import torch
+from torch import nn
+
+from ..quantize import _fake_quantize_weights
+
+PK_INPUTS = 256
+PK_MAX_ACTIVE = 18
+PK_HASH = 0x504B4E31        # "PKN1"
+W1_SCALE = 128.0
+W2_SCALE = 128.0
+B2_SCALE = 128.0 * 128.0
+# int16 safety of the hidden accumulator: |b1| + 18 |w1| <= 255 (x128 = 32,640)
+W1_MAX = 12.0
+B1_MAX = 20.0
+W2_MAX = 127.0 / 128.0
+
+
+class PawnKingNet(nn.Module):
+    def __init__(self, hidden: int, outputs: int):
+        super().__init__()
+        self.hidden = hidden
+        self.outputs = outputs
+        self.w1 = nn.Embedding(PK_INPUTS + 1, hidden, padding_idx=PK_INPUTS)   # last row = padding (-1)
+        self.b1 = nn.Parameter(torch.full((hidden,), 0.25))
+        self.out = nn.Linear(hidden, outputs)
+        with torch.no_grad():
+            self.w1.weight.uniform_(-0.1, 0.1)
+            self.w1.weight[PK_INPUTS].zero_()
+            self.out.weight.zero_()
+            self.out.bias.zero_()
+
+    def forward(self, pk_indices: torch.Tensor, fake_quantize_weights: bool = True) -> torch.Tensor:
+        idx = torch.where(pk_indices < 0, torch.full_like(pk_indices, PK_INPUTS), pk_indices).long()
+        w1, b1 = self.w1.weight, self.b1
+        w2, b2 = self.out.weight, self.out.bias
+        if fake_quantize_weights:
+            w1 = _fake_quantize_weights(w1, W1_SCALE)
+            b1 = _fake_quantize_weights(b1, W1_SCALE)
+            w2 = _fake_quantize_weights(w2, W2_SCALE)
+            b2 = _fake_quantize_weights(b2, B2_SCALE)
+        h = nn.functional.embedding(idx, w1, padding_idx=PK_INPUTS).sum(dim=1) + b1
+        h = h.clamp(0.0, 127.0 / 128.0)
+        return nn.functional.linear(h, w2, b2)
+
+    @torch.no_grad()
+    def clip_weights(self) -> None:
+        self.w1.weight.clamp_(-W1_MAX, W1_MAX)
+        self.w1.weight[PK_INPUTS].zero_()
+        self.b1.clamp_(-B1_MAX, B1_MAX)
+        self.out.weight.clamp_(-W2_MAX, W2_MAX)
+
+    @torch.no_grad()
+    def quantized(self) -> dict:
+        """Integer tensors in the order and layout of the .nnue section (engine: consilium/cn.cpp)."""
+        r = lambda t, s, dt: torch.round(t * s).to(dt)
+        return {
+            "b1": r(self.b1, W1_SCALE, torch.int16),
+            "w1": r(self.w1.weight[:PK_INPUTS], W1_SCALE, torch.int16),          # [256][H]: one row per input
+            "b2": r(self.out.bias, B2_SCALE, torch.int32),
+            "w2": r(self.out.weight, W2_SCALE, torch.int8),                       # [L2][H]
+        }
+
+    @torch.no_grad()
+    def load_quantized(self, b1, w1, b2, w2) -> None:
+        self.b1.copy_(b1.float() / W1_SCALE)
+        self.w1.weight[:PK_INPUTS].copy_(w1.float() / W1_SCALE)
+        self.w1.weight[PK_INPUTS].zero_()
+        self.out.bias.copy_(b2.float() / B2_SCALE)
+        self.out.weight.copy_(w2.float() / W2_SCALE)
