@@ -0,0 +1,67 @@
+import torch
+from torch import nn
+
+from .input_feature import InputFeature
+
+
+class Mobility(InputFeature):
+    """Bucketed mobility inputs (Triumviratus 8.0, graft on the MoE-1024), 29/09/2026.
+
+    FullThreats only encodes attacks on PIECES. This block adds attacks on empty
+    squares in bucketed form: one feature per knight / bishop / rook / queen (own or
+    enemy) = (oriented square, mobility bucket 0-3), 2048 inputs.
+    Mobility = attacked squares not occupied by own pieces and not attacked by
+    enemy pawns. Extraction lives in the C++ data loader ("Mobility"), and must
+    match the engine (Triumviratus_8.0/nnue/nnue/features/mobility.{h,cpp}).
+    """
+
+    HASH = 0x4D4F4231  # "MOB1" — must match the engine-side hash (mobility.h)
+    FEATURE_NAME = "Mobility"
+    INPUT_FEATURE_NAME = "Mobility"
+    MAX_ACTIVE_FEATURES = 32
+
+    NUM_INPUTS = 2048
+    NUM_REAL_FEATURES = 2048
+    EXPORT_WEIGHT_DTYPE = torch.int8
+
+    def __init__(self, num_outputs: int):
+        super().__init__()
+
+        self.num_outputs = num_outputs
+        self.weight = nn.Parameter(
+            torch.empty(self.NUM_INPUTS, num_outputs, dtype=torch.float32)
+        )
+
+        self.reset_parameters()
+
+    def merged_weight(self) -> torch.Tensor:
+        return self.weight
+
+    @torch.no_grad()
+    def coalesce(self) -> None:
+        pass  # no virtual weights
+
+    @torch.no_grad()
+    def zero_virtual_weights(self) -> None:
+        pass  # no virtual weights
+
+    @torch.no_grad()
