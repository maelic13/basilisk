+def parse_lr_pieces(spec):
+    """NNUE_LR_PIECES: segments "steps:from:to[:cos]" separated by ";", values as fractions of --lr."""
+    pieces = []
+    for seg in spec.split(";"):
+        f = seg.strip().split(":")
+        if f[0]:
+            pieces.append((int(f[0]), float(f[1]), float(f[2]), f[3] if len(f) > 3 else "lin"))
+    return pieces
+
+
+def lr_pieces_fraction(pieces, step):
+    for n, a, b, shape in pieces:
+        if step < n:
+            t = step / n
+            if shape == "cos":
+                t = (1 - math.cos(math.pi * t)) / 2
+            return a + (b - a) * t
+        step -= n
+    return pieces[-1][2]
+
+
+class PiecewiseLR(torch.optim.lr_scheduler.LambdaLR):
+    """Triumviratus 27/10/2026 (Consilium Plebis F, the author's schedule): LR made of linear or half-cosine segments,
+    given as fractions of --lr by the environment variable NNUE_LR_PIECES; after the last segment the LR keeps its
+    final value. Stepped every optimizer step like OneCycleLR (per_step, see is_one_cycle in trainer/engine.py)."""
+
+    per_step = True
+
+    def __init__(self, optimizer, pieces):
+        self.pieces = pieces
+        super().__init__(optimizer, lr_lambda=lambda step: lr_pieces_fraction(pieces, step))
+
