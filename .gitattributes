# The pins of other repositories and the SHA-256 manifests of their local
# copies: stored and checked out byte-exact (never end-of-line normalized),
# so a manifest reads the same in every checkout.
docs/reference/** -text -whitespace linguist-vendored
# The oracle bridge patch is applied byte-exact.
tools/oracle/*.patch -text
# Frozen measurement cohorts are hashed byte for byte by the tools that read
# them (each manifest records its EPD's SHA-256), so they never take CRLF.
tools/diag/*_cohort_v*.epd -text
tools/diag/*_cohort_v*.manifest.json -text
