diff --git a/src/board_bench.cpp b/src/board_bench.cpp
new file mode 100644
index 00000000..c4960b3b
--- /dev/null
+++ b/src/board_bench.cpp
@@ -0,0 +1,402 @@
+// cross-engine-board-v2 adapter for classical Stockfish (SF_classical, 9587eeeb).
+//
+// Replaces main() (build: make build BOARD_BENCH=yes, see Makefile). Six columns
+// over the 512-position game file, in the output format of Basilisk's
+// tests/board_micro.cpp that tools/diag/board_micro_run.py parses.
+//
+//   board_bench <positions.fen> [--samples N] [--sample-ms MS] [--columns a,b] [--preflight-only]
+//
+// Stockfish functions used (no change to its board, movegen or search):
+//   legal_gen    generate<LEGAL>(pos, list)      pseudo-legal generation filtered by legal()
+//   capture_gen  generate<CAPTURES> / generate<EVASIONS> when in check (what MovePicker
+//                generates for search and qsearch), pseudo-legal, no legality filter
+//   make_unmake  do_move(m, st, givesCheck) + undo_move, givesCheck precomputed in setup
+//   see_captures see_ge(m, 0) on the legal captures and promotions
+//   gives_check  gives_check(m)
+//   board_perft  MoveList<LEGAL> + do_move(m, st) + undo_move, bulk-counted at depth 1
+//                (Stockfish's own Search::perft shape)
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <functional>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "bitboard.h"
+#include "endgame.h"
+#include "movegen.h"
+#include "position.h"
+#include "search.h"
+#include "thread.h"
+#include "tt.h"
+#include "tune.h"
+#include "uci.h"
+
+namespace PSQT {
+  void init();
+}
+
+#ifndef BOARD_BENCH_SEE_VALUES
+#error "board_bench must be built with BOARD_BENCH=yes (SEE values P100 N300 B300 R500 Q900)"
+#endif
+static_assert(PawnValueMg == 100 && KnightValueMg == 300 && BishopValueMg == 300
+              && RookValueMg == 500 && QueenValueMg == 900, "SEE values");
+
+namespace {
+
+template <typename T>
+inline void keep(T const& value) { asm volatile("" : : "r,m"(value) : "memory"); }
+
+struct Oracle { uint64_t positions = 0, legal = 0, tactical = 0, checking = 0; bool present = false; };
+
+std::vector<std::string> read_fens(const char* path, Oracle& oracle) {
+    std::ifstream in(path);
+    if (!in) {
+        std::fprintf(stderr, "cannot read %s\n", path);
+        std::exit(2);
+    }
+    std::vector<std::string> fens;
+    for (std::string line; std::getline(in, line);) {
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        unsigned long long n[4];
+        if (std::sscanf(line.c_str(), "# Oracle: positions %llu legal %llu tactical %llu checking %llu",
+                        &n[0], &n[1], &n[2], &n[3]) == 4)
+{ oracle.positions = n[0]; oracle.legal = n[1]; oracle.tactical = n[2]; oracle.checking = n[3]; oracle.present = true; }
+        if (line.empty() || line[0] == '#') continue;
+        fens.push_back(line);
+    }
+    return fens;
+}
+
+struct Pass { uint64_t ops; uint64_t sum; };
+
+struct MoveRec { uint32_t pos; Move move; bool check; };
+
+struct Inputs {
+    std::size_t count = 0;
+    std::unique_ptr<Position[]> boards;      // Position is neither copyable nor movable
+    std::unique_ptr<StateInfo[]> root_states;  // one per board, kept alive for st
+    std::vector<MoveRec> all_moves;            // every legal move, with its givesCheck hint
+    std::vector<std::pair<uint32_t, Move>> tactical;  // legal captures (incl. en passant) and promotions
+    ExtMove list[MAX_MOVES];                   // reused generation list
+    StateInfo scratch;                         // reused by make_unmake
+    std::unique_ptr<Position[]> perft_roots;
+    std::unique_ptr<StateInfo[]> perft_root_states;
+    int perft_depths[3] = {4, 3, 5};
+    StateInfo perft_stack[3][8];
+};
+
+const char* const PERFT_FENS[3] = {
+    "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
+    "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1",
+    "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1",
+};
+
+// What MovePicker generates for captures: EVASIONS when in check, else CAPTURES.
+inline ExtMove* generate_captures(const Position& pos, ExtMove* list) {
+    return pos.checkers() ? generate<EVASIONS>(pos, list) : generate<CAPTURES>(pos, list);
+}
+
+Pass legal_generation(Inputs& in) {
+    Pass p{0, 0};
+    for (std::size_t i = 0; i < in.count; ++i) {
+        ExtMove* end = generate<LEGAL>(in.boards[i], in.list);
+        keep(&in.list);
+        const uint64_t n = uint64_t(end - in.list);
+        p.ops += 1;
+        p.sum = p.sum * 31 + n + (n ? uint64_t(in.list[n - 1].move) : 0);
+    }
+    return p;
+}
+
+Pass capture_generation(Inputs& in) {
+    Pass p{0, 0};
+    for (std::size_t i = 0; i < in.count; ++i) {
+        ExtMove* end = generate_captures(in.boards[i], in.list);
+        keep(&in.list);
+        const uint64_t n = uint64_t(end - in.list);
+        p.ops += 1;
+        p.sum = p.sum * 31 + n + (n ? uint64_t(in.list[n - 1].move) : 0);
+    }
+    return p;
+}
+
+Pass make_unmake(Inputs& in) {
+    Pass p{0, 0};
+    for (const MoveRec& r : in.all_moves) {
+        Position& pos = in.boards[r.pos];
+        pos.do_move(r.move, in.scratch, r.check);
+        keep(pos.key());
+        p.sum += pos.key() ^ pos.checkers();
+        pos.undo_move(r.move);
+        p.ops += 1;
+    }
+    return p;
+}
+
+Pass see_captures(Inputs& in) {
+    Pass p{0, 0};
+    for (const std::pair<uint32_t, Move>& t : in.tactical) {
+        const bool r = in.boards[t.first].see_ge(t.second, VALUE_ZERO);
+        keep(r);
+        p.sum = p.sum * 3 + r;
+        p.ops += 1;
+    }
+    return p;
+}
+
+Pass gives_check(Inputs& in) {
+    Pass p{0, 0};
+    for (const MoveRec& m : in.all_moves) {
+        const bool r = in.boards[m.pos].gives_check(m.move);
+        keep(r);
+        p.sum = p.sum * 3 + r;
+        p.ops += 1;
+    }
+    return p;
+}
+
+uint64_t perft(Position& pos, int depth, StateInfo* sts) {
+    if (depth == 1) return MoveList<LEGAL>(pos).size();
+    uint64_t n = 0;
+    for (const ExtMove& m : MoveList<LEGAL>(pos)) {
+        pos.do_move(m, *sts);
+        n += perft(pos, depth - 1, sts + 1);
+        pos.undo_move(m);
+    }
+    return n;
+}
+
+Pass board_perft(Inputs& in) {
+    Pass p{0, 0};
+    for (int i = 0; i < 3; ++i) {
+        const uint64_t n = perft(in.perft_roots[i], in.perft_depths[i], in.perft_stack[i]);
+        p.ops += n;
+        p.sum = p.sum * 1000003 + n;
+    }
+    return p;
+}
+
+struct Column {
+    Column(const char* n, const char* u, std::function<Pass()> f)
+        : name(n), unit(u), run(std::move(f)) {}
+    const char* name;
+    const char* unit;
+    std::function<Pass()> run;
+    Pass expected{};
+    uint64_t passes = 1;
+    std::vector<double> ns_per_op;
+};
+
+double median(std::vector<double> v) {
+    std::sort(v.begin(), v.end());
+    const std::size_t n = v.size();
+    return n % 2 ? v[n / 2] : 0.5 * (v[n / 2 - 1] + v[n / 2]);
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    if (argc < 2) {
+        std::fprintf(stderr, "usage: board_bench <positions.fen> [--samples N] [--sample-ms MS]"
+                             " [--columns a,b] [--preflight-only]\n");
+        return 2;
+    }
+    int samples = 15;
+    double sample_ms = 200.0;
+    bool preflight_only = false;
+    std::string only;
+    for (int a = 2; a < argc; ++a) {
+        if (!std::strcmp(argv[a], "--samples") && a + 1 < argc) samples = std::atoi(argv[++a]);
+        else if (!std::strcmp(argv[a], "--sample-ms") && a + 1 < argc) sample_ms = std::atof(argv[++a]);
+        else if (!std::strcmp(argv[a], "--columns") && a + 1 < argc) only = std::string(",") + argv[++a] + ",";
+        else if (!std::strcmp(argv[a], "--preflight-only")) preflight_only = true;
+        else {
+            std::fprintf(stderr, "unknown argument %s\n", argv[a]);
+            return 2;
+        }
+    }
+    if (samples < 3 || sample_ms <= 0) {
+        std::fprintf(stderr, "need at least 3 samples and a positive sample time\n");
+        return 2;
+    }
+
+    // Stockfish's own start-up, as in its main() (the banner is not printed).
+    UCI::init(Options);
+    Tune::init();
+    PSQT::init();
+    Bitboards::init();
+    Position::init();
+    Bitbases::init();
+    Endgames::init();
+    Threads.set(size_t(Options["Threads"]));
+    Search::clear();
+
+    Oracle oracle;
+    const std::vector<std::string> fens = read_fens(argv[1], oracle);
+
+    // ---- Setup (untimed) ----
+    std::unique_ptr<Inputs> in_ptr(new Inputs());
+    Inputs& in = *in_ptr;
+    in.count = fens.size();
+    in.boards = std::unique_ptr<Position[]>(new Position[in.count]);
+    in.root_states = std::unique_ptr<StateInfo[]>(new StateInfo[in.count]);
+    for (std::size_t i = 0; i < in.count; ++i)
+        in.boards[i].set(fens[i], false, &in.root_states[i], Threads.main());
+    for (uint32_t i = 0; i < in.count; ++i) {
+        ExtMove* end = generate<LEGAL>(in.boards[i], in.list);
+        for (ExtMove* e = in.list; e != end; ++e) {
+            const Move m = e->move;
+            in.all_moves.push_back(MoveRec{i, m, in.boards[i].gives_check(m)});
+            if (in.boards[i].capture(m) || type_of(m) == PROMOTION)
+                in.tactical.emplace_back(i, m);
+        }
+    }
+    in.perft_roots = std::unique_ptr<Position[]>(new Position[3]);
+    in.perft_root_states = std::unique_ptr<StateInfo[]>(new StateInfo[3]);
+    for (int i = 0; i < 3; ++i)
+        in.perft_roots[i].set(PERFT_FENS[i], false, &in.perft_root_states[i], Threads.main());
+
+    // Is the capture generator's output exactly the tactical set? (untimed)
+    uint64_t gen_total = 0, gen_in_set = 0;
+    for (uint32_t i = 0; i < in.count; ++i) {
+        ExtMove* end = generate_captures(in.boards[i], in.list);
+        gen_total += uint64_t(end - in.list);
+        for (ExtMove* e = in.list; e != end; ++e)
+            gen_in_set += std::find(in.tactical.begin(), in.tactical.end(),
+                                    std::make_pair(i, e->move)) != in.tactical.end();
+    }
+    const bool gen_exact = gen_total == in.tactical.size() && gen_in_set == in.tactical.size();
+
+    std::vector<Column> columns = {
+        Column("legal_gen", "positions", [&] { return legal_generation(in); }),
+        Column("capture_gen", "positions", [&] { return capture_generation(in); }),
+        Column("make_unmake", "moves", [&] { return make_unmake(in); }),
+        Column("see_captures", "moves", [&] { return see_captures(in); }),
+        Column("gives_check", "moves", [&] { return gives_check(in); }),
+        Column("board_perft", "leaves", [&] { return board_perft(in); }),
+    };
+    if (!only.empty()) {
+        std::vector<Column> kept;
+        for (Column& c : columns)
+            if (only.find(std::string(",") + c.name + ",") != std::string::npos)
+                kept.push_back(std::move(c));
+        columns.swap(kept);
+        if (columns.empty()) {
+            std::fprintf(stderr, "no column matches %s\n", only.c_str());
+            return 2;
+        }
+    }
+
+    std::printf("profile: cross-engine-board-v2\n");
+    std::printf("positions: %zu (%zu legal moves, %zu tactical)\n", in.count, in.all_moves.size(),
+                in.tactical.size());
+
+    bool ok = true;
+    for (Column& c : columns) {
+        c.expected = c.run();
+        const Pass again = c.run();
+        if (again.ops != c.expected.ops || again.sum != c.expected.sum) {
+            std::fprintf(stderr, "preflight: %s is not repeatable\n", c.name);
+            ok = false;
+        }
+        std::printf("work %-16s %10llu %-9s checksum %016llx\n", c.name,
+                    (unsigned long long)c.expected.ops, c.unit, (unsigned long long)c.expected.sum);
+    }
+    if (!gen_exact)
+        std::printf("noncomparable capture_gen %llu of %zu (generate<CAPTURES>, or generate<EVASIONS> in check,"
+                    " as MovePicker uses it: pseudo-legal and unfiltered; it holds %llu of the %zu legal tactical moves,"
+                    " omits rook/bishop and non-checking knight underpromotions, adds quiet evasions and illegal moves)\n",
+                    (unsigned long long)gen_total, in.tactical.size(), (unsigned long long)gen_in_set,
+                    in.tactical.size());
+
+    uint64_t checking = 0, see_true = 0, perft_total = 0;
+    for (const MoveRec& m : in.all_moves) checking += m.check;
+    for (const std::pair<uint32_t, Move>& t : in.tactical) see_true += in.boards[t.first].see_ge(t.second, VALUE_ZERO);
+    for (int i = 0; i < 3; ++i) {
+        StateInfo st[8];
+        perft_total += perft(in.perft_roots[i], in.perft_depths[i], st);
+    }
+    std::printf("semantic positions %zu\n", in.count);
+    std::printf("semantic legal %zu\n", in.all_moves.size());
+    std::printf("semantic tactical %zu\n", in.tactical.size());
+    std::printf("semantic checking %llu\n", (unsigned long long)checking);
+    std::printf("semantic see_ge0 %llu\n", (unsigned long long)see_true);
+    std::printf("semantic perft %llu\n", (unsigned long long)perft_total);
+    // gives_check() must agree with the check flag do_move would compute.
+    uint64_t gc = 0;
+    for (const MoveRec& m : in.all_moves) gc += in.boards[m.pos].gives_check(m.move);
+    if (gc != checking) {
+        std::fprintf(stderr, "preflight: gives_check is not stable\n");
+        ok = false;
+    }
+    if (perft_total != 197281 + 97862 + 674624) {
+        std::fprintf(stderr, "preflight: perft %llu is not 969767\n", (unsigned long long)perft_total);
+        ok = false;
+    }
+    if (!oracle.present) {
+        std::fprintf(stderr, "preflight: %s has no oracle line\n", argv[1]);
+        ok = false;
+    } else if (oracle.positions != in.count || oracle.legal != in.all_moves.size()
+               || oracle.tactical != in.tactical.size() || oracle.checking != checking) {
+        std::fprintf(stderr, "preflight: the board disagrees with the file's oracle counts\n");
+        ok = false;
+    }
+    if (!ok) return 1;
+    std::printf("preflight: PASS\n");
+    if (preflight_only) return 0;
+
+    using clock = std::chrono::steady_clock;
+    for (Column& c : columns) {
+        const auto t0 = clock::now();
+        uint64_t n = 0;
+        while (std::chrono::duration<double, std::milli>(clock::now() - t0).count() < sample_ms) {
+            keep(c.run().sum);
+            ++n;
+        }
+        c.passes = std::max<uint64_t>(1, n);
+    }
+
+    std::printf("samples: %d round-robin, about %.0f ms each\n", samples, sample_ms);
+    for (int s = 0; s < samples; ++s) {
+        for (Column& c : columns) {
+            uint64_t ops = 0, sum = 0;
+            const auto t0 = clock::now();
+            for (uint64_t k = 0; k < c.passes; ++k) {
+                const Pass p = c.run();
+                ops += p.ops;
+                sum ^= p.sum + k;
+            }
+            const double ns = std::chrono::duration<double, std::nano>(clock::now() - t0).count();
+            keep(sum);
+            if (ops != c.expected.ops * c.passes) {
+                std::fprintf(stderr, "sample %d: %s did %llu operations, not %llu\n", s, c.name,
+                             (unsigned long long)ops, (unsigned long long)(c.expected.ops * c.passes));
+                return 1;
+            }
+            c.ns_per_op.push_back(ns / double(ops));
+            std::printf("sample %2d %-16s %10.3f ns/op\n", s, c.name, c.ns_per_op.back());
+        }
+    }
+
+    std::printf("\n%-16s %12s %10s %8s %12s\n", "column", "median ns/op", "MAD ns", "MAD %", "passes/sample");
+    for (Column& c : columns) {
+        const double med = median(c.ns_per_op);
+        std::vector<double> dev;
+        for (double x : c.ns_per_op) dev.push_back(std::fabs(x - med));
+        const double mad = median(dev);
+        std::printf("%-16s %12.3f %10.3f %7.2f%% %12llu\n", c.name, med, mad, 100.0 * mad / med,
+                    (unsigned long long)c.passes);
+    }
+
+    Threads.set(0);
+    return 0;
+}
