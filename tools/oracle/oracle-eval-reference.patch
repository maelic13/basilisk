+std::string Eval::reference_trace(const Position& pos) {
+
+  if (pos.checkers())
+      return "reference none (in check)";
+  // The record is the donor's whole evaluation; a masked family would leave
+  // its sum and keep its term.
+  if (Eval::ablationMask)
+      return "reference refused: EvalAblationMask is " + std::to_string(Eval::ablationMask);
+
+  const Score contempt = pos.this_thread()->contempt;
+  pos.this_thread()->contempt = SCORE_ZERO;
+  Families fam;
+  const Value final = evaluate_families(pos, fam);
+  pos.this_thread()->contempt = contempt;
+
+  static const char* const Names[7] = {
+      "space", "mobility", "threats", "king", "pawns", "passed", "pieces" };
+  static const char* const PieceNames[4] = { "knights", "bishops", "rooks", "queens" };
+  auto pair = [](std::stringstream& ss, const char* name, Score s) {
+      ss << " " << name << " " << int(mg_value(s)) << " " << int(eg_value(s));
+  };
+
+  std::stringstream ss;
+  ss << "reference specialised " << int(fam.specialised) << " lazy " << fam.lazyExit;
+  pair(ss, "psq", fam.psq);
+  pair(ss, "imbalance", fam.imbalance);
+  for (int bit = 0; bit < 7; ++bit)
+      pair(ss, Names[bit], fam.term[bit]);
+  for (int i = 0; i < 4; ++i)
+      pair(ss, PieceNames[i], fam.pieceType[i]);
+  pair(ss, "complexity", fam.complexity);
+  pair(ss, "adjusted", fam.adjusted);
+  ss << " ph " << fam.phase << " strong " << fam.strongSide
+     << " entrysf " << fam.entryFactor << " scalefn " << int(fam.scalingAnswered)
+     << " generalsf " << fam.generalFactor << " sf " << fam.scaleFactor
+     << " v " << fam.whiteValue << " final " << int(final)
+     // Whether the material key has a registered scaling function, for
+     // either side: the material entry then returns before the imbalance.
+     << " registered " << int(Endgames::probe<ScaleFactor>(pos.material_key()) != nullptr);
+  return ss.str();
+}
+
 Value Eval::evaluate(const Position& pos) {
   if (const int mask = HybridEval::transplant_mask())
       return transplant_value(pos, mask);
