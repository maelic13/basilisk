--- a/hybrid/stockfish/src/evaluate.h
+++ b/hybrid/stockfish/src/evaluate.h
@@ -51,6 +51,21 @@ struct Families {
   int   scaleFactorWhite = SCALE_FACTOR_NORMAL;
   int   scaleFactorBlack = SCALE_FACTOR_NORMAL;
   bool  specialised  = false;
+  // The reference record (the rebuild's parity instrument): the start's two
+  // parts; winnable()'s complexity adjustment of each half and both halves
+  // after it; the strong side it chose; the material entry's factor for that
+  // side and whether a scaling function gave it; the general heuristics'
+  // factor for that side from a normal entry; and the value winnable()
+  // returned, from White's side, before the grain and the tempo.
+  Score psq             = SCORE_ZERO;
+  Score imbalance       = SCORE_ZERO;
+  Score complexity      = SCORE_ZERO;
+  Score adjusted        = SCORE_ZERO;
+  int   strongSide      = 0;
+  int   entryFactor     = SCALE_FACTOR_NORMAL;
+  bool  scalingAnswered = false;
+  int   generalFactor   = SCALE_FACTOR_NORMAL;
+  int   whiteValue      = 0;
 };
 
