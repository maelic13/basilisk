 int Eval::ablationMask = 0;
 
+namespace {
+
+  // A value computed only for its cost must still be computed: link-time
+  // optimisation could otherwise drop the part of an evaluation whose result
+  // is discarded.
+  inline void keep(Value v) { asm volatile("" : : "r"(int(v)) : "memory"); }
+
+  // T(S) = bridge(Basilisk without its families S) + X(S). Basilisk's side
+  // already carries the mask S (HybridEval::set_transplant_mask), and the
+  // donor's EvalAblationMask is 0, so the donor's evaluation is full.
+  Value transplant_value(const Position& pos, int mask) {
+    Eval::Families fam;
+    keep(Evaluation<NO_TRACE>(pos, &fam).value());
+    const Value b = HybridEval::evaluate(pos);
+    const Value x = Eval::transplant_contribution(pos, fam, mask,
+                                                  HybridEval::transplant_mg_scale(),
+                                                  HybridEval::transplant_eg_scale());
+    const Value t = b + x;
+    // Never reached by the measured scales; a static value in the mate range
+    // would corrupt the search's mate arithmetic, so it stops the run.
+    if (abs(t) >= VALUE_TB_WIN_IN_MAX_PLY)
+        std::abort();
+    return t;
+  }
+
+} // namespace
+
+Value Eval::evaluate_families(const Position& pos, Families& out) {
+  out = Families{};
+  return Evaluation<NO_TRACE>(pos, &out).value();
+}
+
+Value Eval::transplant_contribution(const Position& pos, const Families& fam,
+                                    int mask, int mgScale, int egScale) {
+  Score t = SCORE_ZERO;
+  for (int bit = 0; bit < 7; ++bit)
+      if ((mask >> bit) & 1)
+          t += fam.term[bit];
+
+  // X = (s_mg mg(t) ph + s_eg eg(t) (128 - ph) sf / 64) / 128 with the scales
+  // in 1/1024, in one exact integer expression and one division that
+  // truncates toward zero, as the donor's own divisions do.
+  const int64_t ph = fam.phase;
+  const int64_t mg = int(mg_value(t)), eg = int(eg_value(t));
+  const int64_t num =  int64_t(mgScale) * mg * ph * SCALE_FACTOR_NORMAL
+                     + int64_t(egScale) * eg * (PHASE_MIDGAME - ph) * fam.scaleFactor;
+  int64_t x = num / (int64_t(1024) * SCALE_FACTOR_NORMAL * PHASE_MIDGAME);
+
+  // The donor's side to move's point of view, then its rule-50 damping.
+  x = pos.side_to_move() == WHITE ? x : -x;
+  x = x * (100 - pos.rule50_count()) / 100;
+  return Value(int(x));
+}
+
+std::string Eval::transplant_trace(const Position& pos) {
+
+  if (pos.checkers())
+      return "transplant none (in check)";
+  const std::string refused = HybridEval::configuration_error();
+  if (!refused.empty())
+      return "transplant refused: " + refused;
+
+  // The donor's trace evaluates with no contempt; so does this line, so that
+  // the lazy exits it reports are the trace's.
+  const Score contempt = pos.this_thread()->contempt;
+  pos.this_thread()->contempt = SCORE_ZERO;
+  Families fam;
+  const Value donor = evaluate_families(pos, fam);
+  pos.this_thread()->contempt = contempt;
+
+  const int mask = HybridEval::transplant_mask();
+  const int mgScale = HybridEval::transplant_mg_scale();
+  const int egScale = HybridEval::transplant_eg_scale();
+  Score t = SCORE_ZERO;
+  for (int bit = 0; bit < 7; ++bit)
+      if ((mask >> bit) & 1)
+          t += fam.term[bit];
+  // Under a transplant mask the bridge evaluates Basilisk without S; at mask
+  // 0 it is the matched ablation's Basilisk, and T is B.
+  const Value b = HybridEval::evaluate(pos);
+  const Value x = transplant_contribution(pos, fam, mask, mgScale, egScale);
+
+  static const char* const Names[7] = {
+      "space", "mobility", "threats", "king", "pawns", "passed", "pieces" };
+  static const char* const PieceNames[4] = { "knights", "bishops", "rooks", "queens" };
+
+  std::stringstream ss;
+  ss << "transplant mask " << mask << " mgscale " << mgScale << " egscale " << egScale
+     << " B " << int(b) << " mg " << int(mg_value(t)) << " eg " << int(eg_value(t))
+     << " ph " << fam.phase << " sf " << fam.scaleFactor << " X " << int(x)
+     << " T " << int(b + x) << " donor " << int(donor)
+     << " lazy " << fam.lazyExit << " specialised " << int(fam.specialised);
+  for (int bit = 0; bit < 7; ++bit)
+      ss << " " << Names[bit] << " " << int(mg_value(fam.term[bit]))
+         << " " << int(eg_value(fam.term[bit]));
+  for (int i = 0; i < 4; ++i)
+      ss << " " << PieceNames[i] << " " << int(mg_value(fam.pieceType[i]))
+         << " " << int(eg_value(fam.pieceType[i]));
+  return ss.str();
+}
+
 Value Eval::evaluate(const Position& pos) {
-  return HybridEval::enabled() ? HybridEval::evaluate(pos)
-                               : Evaluation<NO_TRACE>(pos).value();
+  if (const int mask = HybridEval::transplant_mask())
+      return transplant_value(pos, mask);
+
+  if (!HybridEval::matched_cost())
+      return HybridEval::enabled() ? HybridEval::evaluate(pos)
+                                   : Evaluation<NO_TRACE>(pos).value();
+
+  // Matched cost: both evaluations run whichever value is returned, so no
+  // arm is faster for evaluating less.
+  const Value donor    = Evaluation<NO_TRACE>(pos).value();
+  const Value basilisk = HybridEval::evaluate(pos);
+  keep(donor);
+  keep(basilisk);
+  return HybridEval::enabled() ? basilisk : donor;
 }
 
 
diff --git a/hybrid/stockfish/src/evaluate.h b/hybrid/stockfish/src/evaluate.h
index d9c8889..6d565ce 100644
--- a/hybrid/stockfish/src/evaluate.h
+++ b/hybrid/stockfish/src/evaluate.h
@@ -36,6 +36,31 @@ namespace Eval {
 // scaling are never masked. 0 is stock.
 extern int ablationMask;
 
+// One full, unmasked evaluation's family scores, White minus Black, in the
+// ablation mask's bit order. A family the evaluation never computed for the
+// position (a specialised endgame, a lazy exit before it) stays zero.
+struct Families {
+  Score term[7]      = {};
+  Score pieceType[4] = {};  // knights, bishops, rooks, queens; term[6] is their sum
+  int   phase        = 0;   // the material entry's game phase, 0..PHASE_MIDGAME
+  int   scaleFactor  = SCALE_FACTOR_NORMAL; // the factor winnable() applied
+  int   lazyExit     = 0;   // 0, or the lazy threshold (1 or 2) that ended it
+  bool  specialised  = false;
+};
+
+// The donor's evaluation with its families recorded; returns its value.
+Value evaluate_families(const Position& pos, Families& out);
+
+// The transplant's donor contribution X(S) from the families in `mask`,
+// interpolated by the evaluation's own phase and scale factor with the two
+// scales (in 1/1024), damped by the donor's rule-50 rule, side to move's view.
+Value transplant_contribution(const Position& pos, const Families& fam,
+                              int mask, int mgScale, int egScale);
+
+// One line with B, mg(t), eg(t), ph, sf, X, T and every family, in internal
+// units, under the configured transplant (the check of the instrument).
+std::string transplant_trace(const Position& pos);
+
 std::string trace(const Position& pos);
 
 Value evaluate(const Position& pos);
diff --git a/hybrid/stockfish/src/hybrid_eval.cpp b/hybrid/stockfish/src/hybrid_eval.cpp
index d55c76e..89b7919 100644
--- a/hybrid/stockfish/src/hybrid_eval.cpp
+++ b/hybrid/stockfish/src/hybrid_eval.cpp
@@ -27,6 +27,22 @@ namespace HybridEval {
 namespace {
 
 bool useBasiliskHce = true;
+int  ablationMask   = 0;
+int  transplantMask = 0;
+int  mgScale        = DefaultTransplantMgScale;
+int  egScale        = DefaultTransplantEgScale;
+bool matchedCost    = false;
+
+// Basilisk's side has one family mask. Under a transplant it removes the
+// transplanted families from Basilisk's evaluation; otherwise it is the
+// matched ablation's mask. Recomputed from both on every change, so the order
+// in which the options arrive does not matter.
+void sync_basilisk_mask() {
+  const int mask = transplantMask ? transplantMask : ablationMask;
+  // A mask Basilisk's side silently ignored would measure nothing.
+  if (!BasiliskBridge::set_eval_ablation_mask(static_cast<std::uint32_t>(mask)))
+      std::abort();
+}
 
 } // namespace
 
@@ -44,9 +60,37 @@ void set_enabled(bool value) {
 
 void set_ablation_mask(int mask) {
   Eval::ablationMask = mask;
-  // A mask Basilisk's side silently ignored would measure nothing.
-  if (!BasiliskBridge::set_eval_ablation_mask(static_cast<std::uint32_t>(mask)))
-      std::abort();
+  ablationMask = mask;
+  sync_basilisk_mask();
+}
+
+void set_transplant_mask(int mask) {
+  transplantMask = mask;
+  sync_basilisk_mask();
+}
+
+void set_transplant_scales(int mg, int eg) {
+  mgScale = mg;
+  egScale = eg;
+}
+
+void set_matched_cost(bool value) {
+  matchedCost = value;
+}
+
+int  transplant_mask()     { return transplantMask; }
+int  transplant_mg_scale() { return mgScale; }
+int  transplant_eg_scale() { return egScale; }
+bool matched_cost()        { return matchedCost; }
+
+std::string configuration_error() {
+  if (transplantMask && !useBasiliskHce)
+      return "EvalTransplantMask " + std::to_string(transplantMask)
+           + " needs Use Basilisk HCE=true";
+  if (transplantMask && ablationMask)
+      return "EvalTransplantMask " + std::to_string(transplantMask)
+           + " needs EvalAblationMask=0, not " + std::to_string(ablationMask);
+  return {};
 }
 
 Value evaluate(const Position& pos) {
